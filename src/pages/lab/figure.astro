---
// /lab/figure: a test page for the point figure. Not linked from the site and kept out of search
// (noindex). Standalone on purpose (no site layout), but it uses the site's tokens, so snapshot
// mode swaps the colors the same way the real page does.
import '../../styles/tokens.css';
import Figure from '../../components/Figure.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Figure lab</title>
  </head>
  <body>
    <main class="lab">
      <section class="lab__hero" aria-label="Figure test">
        <figure class="lab__figure">
          <div class="lab__plate" data-origin-a-y="0.2033" data-origin-b-y="0.6920">
            <Figure alt="A figure of Cayden made of points." />
          </div>
          <figcaption class="lab__caption">Fig. 1&nbsp; Cayden, in <span data-count>…</span> points.</figcaption>
        </figure>
        <div class="lab__panel">
          <h1>Figure lab</h1>
          <p>Move the pointer over this section, or scroll. These buttons change what the figure listens to.</p>
          <div class="lab__buttons">
            <button type="button" data-action="replay">Replay</button>
            <button type="button" data-action="motion" aria-pressed="true">Motion: on</button>
            <button type="button" data-action="snapshot" aria-pressed="false">Snapshot: off</button>
          </div>
          <p class="lab__stats" data-stats>Waiting for the renderer</p>
        </div>
      </section>
    </main>
    <div class="lab__spacer"></div>

    <script>
      const html = document.documentElement;
      const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
      const mount = $('[data-figure-mount]') as HTMLElement & { __figure?: { stats: Record<string, any> } };

      $('.lab__plate').addEventListener('figure:ready', (e) => {
        $('[data-count]').textContent = (e as CustomEvent<{ count: number }>).detail.count.toLocaleString('en-US');
      });
      $('[data-action="replay"]').addEventListener('click', () => {
        mount.dispatchEvent(new CustomEvent('figure:replay', { bubbles: true }));
      });
      $('[data-action="motion"]').addEventListener('click', (e) => {
        const off = html.getAttribute('data-motion') !== 'off';
        if (off) html.setAttribute('data-motion', 'off');
        else html.removeAttribute('data-motion');
        const b = e.currentTarget as HTMLElement;
        b.textContent = `Motion: ${off ? 'off' : 'on'}`;
        b.setAttribute('aria-pressed', String(!off));
      });
      $('[data-action="snapshot"]').addEventListener('click', (e) => {
        const on = !html.hasAttribute('data-snapshot');
        if (on) html.setAttribute('data-snapshot', '');
        else html.removeAttribute('data-snapshot');
        const b = e.currentTarget as HTMLElement;
        b.textContent = `Snapshot: ${on ? 'on' : 'off'}`;
        b.setAttribute('aria-pressed', String(on));
      });

      setInterval(() => {
        const s = mount.__figure && mount.__figure.stats;
        if (!s) return;
        $('[data-stats]').textContent = `${s.state}, WebGL ${s.webgl}, ${s.device}, ${s.file} file, ${s.count} points, ${s.frames} frames${s.reason ? ', ' + s.reason : ''}`;
      }, 500);
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        background: var(--bg, #e2e8e9);
        color: var(--text, #13212d);
        font: 17px/1.5 system-ui, sans-serif;
      }
      .lab {
        padding: 32px 16px;
        max-width: 80rem;
        margin: 0 auto;
      }
      .lab__hero {
        display: grid;
        gap: 24px;
      }
      .lab__figure {
        margin: 0;
      }
      .lab__plate {
        position: relative;
        width: 100%;
        aspect-ratio: 9 / 10;
        background: var(--plate, #f4f7f7);
        border: 1px solid var(--text-2, #4a5965);
        overflow: hidden;
      }
      .lab__caption {
        margin-top: 12px;
        color: var(--text-2, #4a5965);
      }
      .lab__buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .lab__buttons button {
        min-height: 44px;
        padding: 8px 12px;
        font: inherit;
        color: inherit;
        background: transparent;
        border: 1px solid currentColor;
        cursor: pointer;
      }
      .lab__stats {
        font: 13px/1.4 ui-monospace, monospace;
      }
      .lab__spacer {
        height: 1400px;
      }
      @media (min-width: 1024px) {
        .lab__hero {
          grid-template-columns: 7fr 5fr;
          align-items: center;
        }
        .lab__figure {
          width: min(100%, 608px);
        }
        .lab__plate {
          aspect-ratio: 4 / 5;
        }
      }
    </style>
  </body>
</html>
