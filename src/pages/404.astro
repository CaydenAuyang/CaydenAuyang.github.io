---
// 404.astro: shown at any address that doesn't exist. GitHub Pages serves dist/404.html for
// those. Same night, no scene: the night gradient behind a short message, in every mode (the
// hero still would put the figure behind the title). It has no canonical link (Base.astro leaves
// it out on this page).
import Base from '../layouts/Base.astro';
import { site, ui } from '../data/site';
---

<Base title={`${ui.notFoundTitle} · ${site.name}`} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf__body scrim">
      <h1 id="nf-title" class="h2">{ui.notFoundTitle}</h1>
      <p class="t-lead">{ui.notFoundBody}</p>
      <p><a class="action-link" href="/">{ui.notFoundLink}</a></p>
    </div>
  </section>
</Base>

<style>
  /* The night gradient, never the hero still with the figure (which reduced motion would show). */
  :global(.world-fallback[data-still]) {
    background-image: var(--night-gradient) !important;
  }
  :global(.world-fallback[data-still]::before) {
    display: none !important;
  }
  /* The message's scrim reaches past the section; clipped here, so the page doesn't scroll. */
  .nf {
    overflow: hidden;
    overflow: clip;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--space-9);
  }
  .nf__body > * + * {
    margin-top: var(--space-4);
  }
  .nf__body > p:last-child {
    margin-top: var(--space-3);
  }
</style>
