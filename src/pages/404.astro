---
// 404.astro: shown at any address that doesn't exist. GitHub Pages serves dist/404.html for
// those. Same night, no scene: the still (or gradient) behind a short message. It has no
// canonical link (Base.astro leaves it out on this page).
import Base from '../layouts/Base.astro';
import { site, ui } from '../data/site';
---

<Base title={`${ui.notFoundTitle} · ${site.name}`} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf__body scrim">
      <h1 id="nf-title" class="h2">{ui.notFoundTitle}</h1>
      <p class="t-lead">{ui.notFoundBody}</p>
      <p><a class="action-link" href="/">{ui.notFoundLink}</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--space-9);
  }
  /* Unbounded sets "Page not found" on two lines on phones where the stand-in font fits one;
     reserve both lines so the swap doesn't move the page. */
  @media (max-width: 767px) {
    .nf h1 {
      min-height: calc(2em * 0.95);
    }
  }
  .nf__body > * + * {
    margin-top: var(--space-4);
  }
  .nf__body > p:last-child {
    margin-top: var(--space-3);
  }
</style>
