---
// index.astro: the home page, and the whole site. One section per component, in the fixed order
// of the copy file. Every word comes from src/data/content.ts.
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/intro/Intro.astro';
import Mission from '../components/sections/Mission.astro';
import Experience from '../components/sections/Experience.astro';
import Work from '../components/sections/Work.astro';
import Contact from '../components/sections/Contact.astro';
---

<Base menu world>
  <Hero />
  <Intro />
  <Mission />
  <Experience />
  <Work />
  <Contact slot="footer" />
</Base>
