---
// index.astro: the home page, and for now the whole site. One section per component, in the
// order of the brief's site outline. Every word comes from src/data/content.ts.
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Question from '../components/sections/Question.astro';
import Summer from '../components/sections/Summer.astro';
import Work from '../components/sections/Work.astro';
import Progress from '../components/sections/Progress.astro';
import People from '../components/sections/People.astro';
import Portfolio from '../components/sections/Portfolio.astro';
---

<Base nav>
  <Hero />
  <Question />
  <Summer />
  <Work />
  <Progress />
  <!-- People and Portfolio share a row on laptops. -->
  <div class="duo">
    <People />
    <Portfolio />
  </div>
</Base>

<style>
  @media (min-width: 1024px) {
    .duo {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: var(--max-page);
      margin-inline: auto;
      border-top: 1px solid var(--rule);
    }
    .duo > :global(.section) {
      border-top: 0;
    }
    .duo > :global(.section:first-child .wrap) {
      padding-right: calc(var(--gutter) / 2);
    }
    .duo > :global(.section:last-child .wrap) {
      padding-left: calc(var(--gutter) / 2);
    }
  }
</style>
