---
// Contact.astro: section 7, the footer. "Say hello", the email as the largest link on the page,
// GitHub, the portfolio line and the small print, centered under the two lights.
//
// The signal gathers into two lights at the contact key (LIGHT_ANCHORS in the world contract,
// as viewport fractions): Pomfret on the left, Hong Kong on the right. This section is at least
// one viewport tall and ends the page, so when it fills the screen the two small labels sit
// right under those lights.
import ExternalLink from '../ui/ExternalLink.astro';
import { LIGHT_ANCHORS } from '../../world/contract';
import { contact } from '../../data/content';
import { ui } from '../../data/site';

const at = (a: { x: number; y: number }) => `--lx: ${a.x}; --ly: ${a.y}`;
---

<footer class="site-footer">
  <section
    id="contact"
    class="contact"
    data-scene="contact"
    aria-labelledby="contact-title"
    style={`--lights-y: ${Math.max(LIGHT_ANCHORS.pomfret.y, LIGHT_ANCHORS.hongKong.y)}`}
  >
    <p class="contact__light" style={at(LIGHT_ANCHORS.pomfret)} aria-hidden="true">{contact.lights.pomfret}</p>
    <p class="contact__light" style={at(LIGHT_ANCHORS.hongKong)} aria-hidden="true">{contact.lights.hongKong}</p>

    <div class="contact__body wrap scrim scrim--soft">
      <h2 id="contact-title" class="h2">{contact.heading}</h2>
      <p class="contact__email-wrap">
        <a class="contact__email" href={`mailto:${contact.email.text}`}
          ><span class="sr-only">{ui.emailLabel}: </span>{contact.email.text}</a
        >
      </p>
      <p>
        <ExternalLink class="action-link" href={contact.github.href} arrow>{contact.github.label}</ExternalLink>
      </p>
      <p class="contact__portfolio t-body t-dim">{contact.portfolio.text}</p>
      <p class="contact__small t-small t-dim">{contact.smallPrint}</p>
    </div>
  </section>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
  }
  .contact {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: calc(var(--lights-y) * 100vh + var(--space-9));
    padding-top: calc(var(--lights-y) * 100dvh + var(--space-9));
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
  }

  /* Under each light: centered on its x, a little below its y. */
  .contact__light {
    position: absolute;
    left: calc(var(--lx) * 100%);
    top: calc(var(--ly) * 100vh + var(--space-5));
    top: calc(var(--ly) * 100dvh + var(--space-5));
    transform: translateX(-50%);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--dim);
    white-space: nowrap;
    text-shadow: var(--halo);
  }

  .contact__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .contact__body > * + * {
    margin-top: var(--space-3);
  }
  .contact__email-wrap {
    margin-top: var(--space-5) !important;
    max-width: 100%;
  }
  .contact__email {
    display: inline-block;
    max-width: 100%;
    font-size: var(--fs-email);
    font-weight: var(--fw-medium);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--window);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: rgb(var(--window-rgb) / 0.4);
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .contact__email:hover {
    text-decoration-color: var(--window);
  }
  .contact__portfolio {
    max-width: var(--measure);
    margin-top: var(--space-5) !important;
  }
  .contact__small {
    margin-top: var(--space-6) !important;
  }
</style>
