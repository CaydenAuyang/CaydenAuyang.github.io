---
// Contact.astro: the contact block and site footer, shown on every page: "the night side".
// Ink ground with chart-colored text and mist for the quieter lines. Inside it, the semantic
// colors are re-pointed (--text, --text-2, --focus...) so every part reads correctly on ink,
// and snapshot mode turns it white simply by changing the footer tokens.
import { footer } from '../../data/content';
import { places } from '../../data/site';
import ExternalLink from '../ui/ExternalLink.astro';
import MotionToggle from '../ui/MotionToggle.astro';
import SnapshotToggle from '../ui/SnapshotToggle.astro';
import Say from '../ui/Say.astro';
---

<footer id="contact" class="site-footer">
  <div class="wrap grid site-footer__grid">
    <div class="site-footer__who">
      <p class="site-footer__line"><Say line={footer.line} /></p>
      <ul class="site-footer__links">
        <li>
          {footer.emailLabel}: <a href={footer.email.href}>{footer.email.text}</a>
        </li>
        <li>
          {footer.githubLabel}: <ExternalLink href={footer.github.href}>{footer.github.text}</ExternalLink>
        </li>
      </ul>
    </div>
    <div class="site-footer__controls">
      <MotionToggle />
      <SnapshotToggle />
    </div>
    <p class="site-footer__coords t-label tnum">
      <span>{places.pomfret.name} {places.pomfret.coords}</span>
      <span>{places.hongKong.name} {places.hongKong.coords}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --text: var(--footer-text);
    --text-2: var(--footer-text-2);
    --neatline: var(--footer-text-2);
    --focus: var(--footer-focus);
    --focus-halo: var(--footer-bg);
    background: var(--footer-bg);
    color: var(--footer-text);
  }
  :global(html[data-snapshot]) .site-footer {
    border-top: 1px solid var(--rule);
  }
  .site-footer__grid {
    row-gap: var(--space-6);
    padding-block: var(--space-8) var(--space-7);
  }
  .site-footer__who {
    display: grid;
    gap: var(--space-4);
  }
  .site-footer__line {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-lead);
    line-height: 1.3;
  }
  .site-footer__links {
    display: grid;
    gap: var(--space-1);
  }
  .site-footer__links a {
    display: inline-block;
    padding-block: var(--space-2);
  }
  .site-footer__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-3);
  }
  .site-footer__coords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    color: var(--footer-text-2);
  }
  @media (min-width: 1024px) {
    .site-footer__who {
      grid-column: 1 / span 6;
    }
    .site-footer__controls {
      grid-column: 7 / span 6;
      justify-content: end;
    }
    .site-footer__coords {
      grid-column: 1 / -1;
      padding-top: var(--space-5);
      border-top: 1px solid rgb(154 171 180 / 0.35);
    }
  }
</style>
