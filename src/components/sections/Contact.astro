---
// Contact.astro: section 7, the footer. "Reach out", the email as the largest link on the page,
// GitHub and the small print, centered under the two lights. The harbour light show runs on its own
// while Contact is on screen (the world's, NIGHT-SIGNAL.md 11b.9); nothing here controls it.
//
// The signal gathers into two lights at the contact key (LIGHT_ANCHORS in the world contract,
// as viewport fractions): Pomfret on the left, Hong Kong on the right. This section is at least
// one viewport tall and ends the page, so when it fills the screen the two small labels sit
// right under those lights. The labels scroll with the page while the lights stay fixed, so
// they fade in only once the page is scrolled to the very bottom (within 4px), where they line
// up. Snapshot captures Contact at the bottom too. Without JavaScript they simply show.
//
// Two cities (NIGHT-SIGNAL.md 11b.7): under each label, that city's local time (America/New_York
// for Pomfret, Asia/Hong_Kong for Hong Kong), computed in the browser with Intl.DateTimeFormat and
// updated on the minute; empty (and hidden) without JavaScript, never hard-coded. A "Copy email"
// button beside GitHub copies the address and says "Copied" for 2 s (announced politely by a
// status line). Hovering or focusing the email sends `world:arc`, an extra light along the arc.

import ExternalLink from '../ui/ExternalLink.astro';
import { LIGHT_ANCHORS } from '../../world/contract';
import { contact } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';
import { ui } from '../../data/site';

const at = (a: { x: number; y: number }) => `--lx: ${a.x}; --ly: ${a.y}`;

const headline = ignite(contact.heading);
---

<footer class="site-footer">
  <section
    id="contact"
    class="contact"
    data-scene="contact"
    aria-labelledby="contact-title"
    style={`--lights-y: ${Math.max(LIGHT_ANCHORS.pomfret.y, LIGHT_ANCHORS.hongKong.y)}`}
  >
    {
      [
        { name: contact.lights.pomfret, anchor: LIGHT_ANCHORS.pomfret, zone: 'America/New_York' },
        { name: contact.lights.hongKong, anchor: LIGHT_ANCHORS.hongKong, zone: 'Asia/Hong_Kong' },
      ].map((light) => (
        <div class="contact__light" style={at(light.anchor)} aria-hidden="true">
          <p class="t-label">{light.name}</p>
          <p class="contact__time t-meta" data-clock={light.zone} />
        </div>
      ))
    }

    <div class="contact__body wrap scrim">
      <h2 id="contact-title" class="h2" {...headline.attrs} set:html={titleHtml(contact.heading)} />
      <p class="contact__email-wrap">
        <a class="contact__email" href={`mailto:${contact.email.text}`}
          ><span class="sr-only">{ui.emailLabel}: </span>{contact.email.text}</a
        >
      </p>
      <p class="contact__actions">
        <button type="button" class="contact__copy" data-copy-email={contact.email.text} data-needs-js data-snapshot-hide>
          {ui.copyEmail}
        </button>
        <ExternalLink class="action-link" href={contact.github.href} arrow>{contact.github.label}</ExternalLink>
      </p>
      <p class="sr-only" role="status" data-copy-status></p>
      <p class="contact__small t-meta">{contact.smallPrint}</p>
    </div>
  </section>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
  }
  /* overflow: clip so the body's scrim can't extend the page past the footer: the page must end
     exactly where this section does, or the labels miss their lights (and print adds a page). */
  .contact {
    position: relative;
    overflow: clip;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: calc(var(--lights-y) * 100vh + var(--space-9));
    padding-top: calc(var(--lights-y) * 100dvh + var(--space-9));
    padding-top: round(nearest, calc(var(--lights-y) * 100dvh + var(--space-9)), 8px);
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
  }

  /* Under each light: centered on its x, a little below its y. */
  :global(html.js) .contact:not(.is-home) .contact__light {
    opacity: 0;
  }
  .contact__light {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    transition: opacity var(--dur-fade) var(--ease-out);
    position: absolute;
    left: calc(var(--lx) * 100%);
    /* From the section's bottom, which meets the window's bottom at the end of the page, so the
       labels stay under the lights even when the section is taller than the window. */
    top: calc(100% - (1 - var(--ly)) * 100vh + var(--space-5));
    top: calc(100% - (1 - var(--ly)) * 100dvh + var(--space-5));
    transform: translateX(-50%);
    white-space: nowrap;
    text-shadow: var(--halo);
  }

  /* The scrim reaches 50% of the body's height above it (still inside this section, so the clip
     never shows as an edge) and further below, where the clip is the end of the page. */
  .contact__body.scrim::before {
    inset: -50% -80% -80%;
  }
  .contact__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .contact__body > * + * {
    margin-top: var(--space-3);
  }
  .contact__email-wrap {
    margin-top: var(--space-3) !important;
    max-width: 100%;
  }
  .contact__email {
    display: inline-block;
    max-width: 100%;
    /* At least a 44px target on phones (32px of text plus 8px above and below). */
    padding-block: var(--space-2);
    font-size: var(--fs-email);
    font-weight: var(--fw-medium);
    line-height: 1.15;
    color: var(--window);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: rgb(var(--window-rgb) / 0.4);
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .contact__email:hover {
    text-decoration-color: var(--window);
  }
  /* The labels sit right under the two lights, and in Contact the harbour light show's beams sweep
     behind them too, so the pair carries a darker scrim of its own (night at 70% in the middle),
     on top of each line's own. */
  .contact__light::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-2) * -1) calc(var(--space-5) * -1);
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgb(var(--night-rgb) / 0.7) 0%,
      rgb(var(--night-rgb) / 0.7) 60%,
      rgb(var(--night-rgb) / 0) 100%
    );
    pointer-events: none;
  }
  /* One line each, even at the screen's edge (the labels' own text-wrap would undo an inherited
     nowrap). */
  .contact__light > * {
    white-space: nowrap;
  }
  .contact__time {
    font-variant-numeric: tabular-nums;
  }
  .contact__time:empty {
    display: none;
  }

  /* GitHub and Copy email side by side. The button is wide enough for "Copy email" in either
     state (monospace: 10 characters plus its padding), so "Copied" never moves GitHub. */
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }
  .contact__copy {
    min-height: var(--tap);
    min-width: calc(10ch + 2 * var(--space-3) + 2px);
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    border: 1px solid rgb(var(--window-rgb) / 0.45);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--window);
    text-align: center;
    transition:
      border-color var(--dur-quick) var(--ease-out),
      background var(--dur-quick) var(--ease-out);
  }
  .contact__copy:hover {
    border-color: var(--window);
    background: rgb(var(--window-rgb) / 0.08);
  }
  .contact__copy[data-copied] {
    border-color: var(--window);
  }

  .contact__small {
    margin-top: var(--space-6) !important;
  }
</style>

<script>
  import '../../scripts/contact';
  // Show the light labels only at the bottom of the page, where they sit under the lights.
  const section = document.querySelector<HTMLElement>('.contact');
  if (section) {
    let queued = false;
    const check = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      section.classList.toggle('is-home', max - window.scrollY <= 4);
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(check);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    window.addEventListener('world:layout', queue);
    check();
  }
</script>
