---
// People.astro: section 6. The professionals outside Pomfret who shaped the work.
import { people } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';

const headline = ignite(people.heading);
---

<section id="people" class="scene people" data-scene="people" aria-labelledby="people-title">
  <div class="wrap grid">
    <div class="people__block stack scrim">
      <h2 id="people-title" class="h2" {...headline.attrs} set:html={titleHtml(people.heading)} />
      <ul class="people__list">
        {
          people.list.map((person) => (
            <li class="person">
              <h3 class="person__name t-sub">{person.name}</h3>
              <p class="t-meta">{person.role.text}</p>
              <p class="t-body person__text">{person.text.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .people {
    --scene-h: 60vh;
  }
  .person {
    display: grid;
    gap: var(--space-2);
  }
  /* With the grid's 8px gap above it, 16px from the role line. */
  .person__text {
    margin-top: var(--space-2);
  }
  /* Tablets (768 to 1023px): all 12 narrow columns, as on phones. Desktop: the right column. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .people__block {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .people__block {
      grid-column: 8 / span 5;
    }
    /* The headline fits its word to the column (base.css --wmax). */
    .people__block {
      --fit-w: var(--col-right);
    }
  }
</style>
