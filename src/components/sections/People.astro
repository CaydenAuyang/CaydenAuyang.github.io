---
// People.astro: section 6. Professionals outside Pomfret who shaped the work.
// Confirmed connections only. If the list is empty, the section shows just its intro.
import { people } from '../../data/content';
import Say from '../ui/Say.astro';
---

<section id="people" class="section" aria-labelledby="people-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="people-title" class="section__title">{people.heading}</h2>
      <p class="t-lead"><Say line={people.intro} /></p>
    </div>
    {
      people.list.length > 0 && (
        <ul class="people">
          {people.list.map((person) => (
            <li class="person">
              <h3 class="person__name">{person.name}</h3>
              <p class="t-meta">
                <Say line={person.title} />
              </p>
              <p>
                <Say line={person.body} />
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .people {
    display: grid;
    gap: var(--space-6);
  }
  .person {
    display: grid;
    gap: var(--space-2);
    max-width: var(--max-text);
  }
  .person__name {
    font-size: var(--fs-h3);
  }
</style>
