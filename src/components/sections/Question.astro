---
// Question.astro: section 2. The headline, the lead, and the May / Edits / October panel with
// its four notes (QuestionPanel.astro).
import QuestionPanel from '../ui/QuestionPanel.astro';
import { question } from '../../data/content';
---

<section id="question" class="scene question" data-scene="question" aria-labelledby="question-title">
  <div class="wrap">
    <div class="question__head stack scrim">
      <h2 id="question-title" class="h2">{question.heading}</h2>
      <p class="t-lead">{question.lead.text}</p>
    </div>
    <QuestionPanel
      views={question.views}
      may={question.may}
      october={question.october}
      edits={question.edits}
      notes={question.notes}
    />
  </div>
</section>

<style>
  .question {
    --scene-h: 120vh;
  }
  .question__head {
    margin-bottom: var(--space-6);
  }
</style>
