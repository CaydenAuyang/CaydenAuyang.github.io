---
// Summer.astro: section 3. Civic Exchange, summer 2026: headline, subhead, meta, lead, four
// facts, and the full section from the long copy behind More.
import More from '../ui/More.astro';
import { summer } from '../../data/content';
---

<section id="summer" class="scene summer" data-scene="summer" aria-labelledby="summer-title">
  <div class="wrap grid">
    <div class="summer__block stack scrim">
      <h2 id="summer-title" class="h2">{summer.heading}</h2>
      <div class="summer__where">
        <p class="t-sub">{summer.subhead}</p>
        <p class="t-small">{summer.meta.text}</p>
      </div>
      <p class="t-lead">{summer.lead.text}</p>
      <ul class="facts">
        {summer.facts.map((fact) => <li>{fact.text}</li>)}
      </ul>
      <More id="summer-more" label={summer.moreLabel}>
        {
          summer.more.map((block) => (
            <>
              {block.text && (
                <p>
                  <strong>{block.title}</strong> {block.text.text}
                </p>
              )}
              {block.list && (
                <>
                  <p>
                    <strong>{block.title}</strong>
                  </p>
                  <ul>
                    {block.list.map((item) => (
                      <li>{item.text}</li>
                    ))}
                  </ul>
                </>
              )}
            </>
          ))
        }
      </More>
    </div>
  </div>
</section>

<style>
  .summer {
    --scene-h: 140vh;
  }
  .summer__where {
    display: grid;
    gap: var(--space-1);
  }
  .summer .facts {
    margin-top: var(--space-4);
  }
  /* Snapshot: one screen. The short copy on the left, the long copy beside it in two columns. */
  @media (min-width: 1024px) {
    :global(html[data-snapshot]) .summer__block {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: start;
    }
    :global(html[data-snapshot]) .summer__block > * {
      grid-column: 1 / span 5;
    }
    :global(html[data-snapshot]) .summer__block > :global(.more) {
      grid-column: 7 / span 6;
      grid-row: 1 / span 5;
      margin-top: 0;
    }
    :global(html[data-snapshot]) .summer :global(.more__inner) {
      columns: 2;
      column-gap: var(--space-5);
      padding-top: 0;
    }
    :global(html[data-snapshot]) .summer :global(.more__inner p:has(+ ul)) {
      break-after: avoid;
    }
    :global(html[data-snapshot]) .summer :global(.more__inner li) {
      break-inside: avoid;
    }
  }

  /* Desktop: the right column (the same edge as the work text), clear of the archive rising
     over Central, left of center. */
  @media (min-width: 1024px) {
    .summer__block {
      grid-column: 8 / span 5;
    }
  }
</style>
