---
// Summer.astro: section 3. Civic Exchange, summer 2026: headline, subhead, meta, lead, four
// facts, and the full section from the long copy behind More.
import More from '../ui/More.astro';
import { summer } from '../../data/content';
---

<section id="summer" class="scene summer" data-scene="summer" aria-labelledby="summer-title">
  <div class="wrap grid">
    <div class="summer__block stack scrim">
      <h2 id="summer-title" class="h2">{summer.heading}</h2>
      <div class="summer__where">
        <p class="t-sub">{summer.subhead}</p>
        <p class="t-small t-dim">{summer.meta.text}</p>
      </div>
      <p class="t-lead">{summer.lead.text}</p>
      <ul class="facts">
        {summer.facts.map((fact) => <li>{fact.text}</li>)}
      </ul>
      <More id="summer-more" label={summer.moreLabel}>
        {
          summer.more.map((block) => (
            <>
              {block.text && (
                <p>
                  <strong>{block.title}</strong> {block.text.text}
                </p>
              )}
              {block.list && (
                <>
                  <p>
                    <strong>{block.title}</strong>
                  </p>
                  <ul>
                    {block.list.map((item) => (
                      <li>{item.text}</li>
                    ))}
                  </ul>
                </>
              )}
            </>
          ))
        }
      </More>
    </div>
  </div>
</section>

<style>
  .summer {
    --scene-h: 140vh;
  }
  .summer__where {
    display: grid;
    gap: var(--space-1);
  }
  .summer .facts {
    margin-top: var(--space-4);
  }
  /* Desktop: the right half, clear of the archive rising over Central (left of center). */
  @media (min-width: 1024px) {
    .summer__block {
      grid-column: 7 / span 6;
    }
  }
</style>
