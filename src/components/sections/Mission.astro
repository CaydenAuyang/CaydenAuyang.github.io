---
// Mission.astro: section 2. The Previously / Edits / Now panel (MissionPanel.astro), with no
// headline, lead or notes of its own (V4 section 5). The nav and the lift still say Mission, so
// the section keeps its #mission anchor and is named by a visually hidden heading (taken out of
// the flow, so nothing measures it for layout). The camera stop keeps its internal name:
// data-scene="question".
import MissionPanel from '../ui/MissionPanel.astro';
import { mission } from '../../data/content';
---

<section id="mission" class="scene mission" data-scene="question" aria-labelledby="mission-name">
  <div class="wrap">
    <h2 id="mission-name" class="sr-only">{mission.name}</h2>
    <MissionPanel views={mission.views} from={mission.from} to={mission.to} edits={mission.edits} />
  </div>
</section>

<style>
  .mission {
    --scene-h: 120vh;
  }
</style>
