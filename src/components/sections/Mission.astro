---
// Mission.astro: section 2. The title, WHY I BUILD (V5 section 3), then the Previously / Edits /
// Now panel (MissionPanel.astro), with no lead or notes (V4 section 5). The title is a section
// title like the others (the neon ignition and the flicker), left-aligned with the panel, as far
// above it as EXPERIENCE is above CIVIC EXCHANGE; the nav and the lift still say Mission. The
// timeline clears the hero figure as it rises when nothing comes between them (timeline.ts). The
// camera stop keeps its internal name: data-scene="question".
import MissionPanel from '../ui/MissionPanel.astro';
import { mission } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';

const headline = ignite(mission.heading);
---

<section id="mission" class="scene mission" data-scene="question" aria-labelledby="mission-title">
  <div class="wrap">
    <div class="mission__head scrim">
      <h2 id="mission-title" class="h2" {...headline.attrs} set:html={titleHtml(mission.heading)} />
    </div>
    <MissionPanel views={mission.views} from={mission.from} to={mission.to} edits={mission.edits} />
  </div>
</section>

<style>
  .mission {
    --scene-h: 120vh;
  }
  /* The same gap as EXPERIENCE to CIVIC EXCHANGE (Experience.astro, .xp__civic). */
  .mission__head {
    margin-bottom: var(--space-5);
  }
</style>
