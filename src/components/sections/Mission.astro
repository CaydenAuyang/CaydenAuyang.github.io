---
// Mission.astro: section 2, Where it started (Nov 1 2026; it replaced the mission's Previously /
// Edits / Now question in the same place). The title, then the panel (StartPanel.astro): a short
// opening in Cayden's words and a dated list, drawn as two lines of light (Nov 7). The title is a section title like the others (the
// neon ignition and the flicker), left-aligned with the panel, as far above it as EXPERIENCE is
// above CIVIC EXCHANGE; the nav and the lift say Origins. The timeline clears the hero figure as it
// rises when nothing comes between them (timeline.ts). The section keeps its id (#mission) and the
// camera stop its internal name: data-scene="question".
import StartPanel from '../ui/StartPanel.astro';
import { mission } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';

const headline = ignite(mission.heading);
---

<section id="mission" class="scene mission" data-scene="question" aria-labelledby="mission-title">
  <div class="wrap">
    <div class="mission__head scrim">
      <h2 id="mission-title" class="h2" {...headline.attrs} set:html={titleHtml(mission.heading)} />
    </div>
    <StartPanel lead={mission.lead} steps={mission.steps} />
  </div>
</section>

<style>
  .mission {
    --scene-h: 120vh;
  }
  /* The same gap as EXPERIENCE to CIVIC EXCHANGE (Experience.astro, .xp__civic). */
  .mission__head {
    margin-bottom: var(--space-5);
  }
</style>
