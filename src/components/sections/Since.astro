---
// Since.astro: section 5. Since May: Build, Apply, Reflect, each with its status in one line,
// and the full progress section from the long copy behind More.
import More from '../ui/More.astro';
import { since } from '../../data/content';
import { ignite } from '../ui/ignite';

const headline = ignite(since.heading);
---

<section id="since" class="scene since" data-scene="since" aria-labelledby="since-title">
  <div class="wrap">
    <div class="since__block scrim">
      <div class="since__head stack">
        <h2 id="since-title" class="h2" {...headline.attrs}>{since.heading}</h2>
        <p class="t-lead">{since.lead.text}</p>
      </div>
      <ol class="strands">
        {
          since.strands.map((strand) => (
            <li class="strand">
              <h3 class="strand__label t-label">{strand.label}</h3>
              <p class="strand__status t-sub">{strand.status}</p>
              <p class="strand__text">{strand.text.text}</p>
            </li>
          ))
        }
      </ol>
      <More id="since-more" label={since.moreLabel} class="since__more">
        {
          since.strands.map((strand) => (
            <div class="since__detail">
              <p>
                <strong>{strand.label}</strong>
              </p>
              <p>
                <strong>{since.proposedLabel}</strong> {strand.proposed.text}
              </p>
              <p>
                <strong>{since.nowLabel}</strong> {strand.now.text}
              </p>
            </div>
          ))
        }
      </More>
    </div>
  </div>
</section>

<style>
  .since {
    --scene-h: 120vh;
  }
  .since__head {
    margin-bottom: var(--space-6);
  }
  .strands {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    /* Three equal columns with the grid's 32px gap line up with columns 1, 5 and 9. */
    .strands {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .strand {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .strand__status {
    margin-top: var(--space-1);
  }
  .strand__text {
    margin-top: var(--space-2);
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .since :global(.since__more) {
    margin-top: var(--space-5);
  }
  .since :global(.since__more .more__inner) {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .since :global(.since__more .more__inner) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .since :global(.since__more .more__inner > * + *) {
    margin-top: 0;
  }
  .since :global(.since__detail > * + *) {
    margin-top: var(--space-2);
  }
</style>
