---
// Work.astro: section 4. The three projects, each with a looping preview and a live link.
//
// The preview recordings come from the previews tool (tools/previews/), which writes
// src/data/previews.json. That file may not exist yet, so it is looked up softly here: a project
// without a recording shows a "To come" frame. Expected shape, keyed by project id:
//   { "civic-ai-club": { "mp4": "/media/previews/x.mp4", "webm": "/media/previews/x.webm",
//                        "poster": "/media/previews/x.jpg", "width": 1600, "height": 1000 }, ... }
// A list of objects with an "id" field also works.
import { work, type Project } from '../../data/content';
import LoopVideo, { type VideoSource } from '../ui/LoopVideo.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import Say from '../ui/Say.astro';

const found = import.meta.glob<{ default: unknown }>('../../data/previews.json', { eager: true });
const raw = Object.values(found)[0]?.default;

function previewFor(id: Project['id']): VideoSource | undefined {
  if (!raw || typeof raw !== 'object') return undefined;
  const list = Array.isArray(raw) ? raw : (raw as Record<string, unknown>).previews;
  const entry = Array.isArray(list)
    ? list.find((x: { id?: string }) => x?.id === id)
    : (raw as Record<string, unknown>)[id];
  const v = entry as Partial<VideoSource> | undefined;
  return v && v.mp4 && v.poster ? (v as VideoSource) : undefined;
}
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="work-title" class="section__title">{work.heading}</h2>
      <p class="t-lead"><Say line={work.intro} /></p>
    </div>
    <div class="work">
      {
        work.projects.map((project) => (
          <article class="project" id={`work-${project.id}`} aria-labelledby={`work-${project.id}-title`}>
            <div class="project__preview">
              <LoopVideo name={project.name} caption={project.caption.text} src={previewFor(project.id)} />
            </div>
            <div class="project__text">
              <h3 id={`work-${project.id}-title`} class="project__name">{project.name}</h3>
              <p class="t-meta"><Say line={project.role} /></p>
              <p><Say line={project.summary} /></p>
              <ul class="project__points">
                {project.points.map((point) => (
                  <li>
                    <Say line={point} />
                  </li>
                ))}
              </ul>
              {project.study && (
                <div class="project__study">
                  <h4 class="project__study-name">
                    {project.study.name} <span class="t-meta">{project.study.when}</span>
                  </h4>
                  <p>
                    <Say line={project.study.body} />
                  </p>
                </div>
              )}
              <p class="project__link">
                <ExternalLink href={project.link.href}>{project.link.text}</ExternalLink>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: var(--space-8);
  }
  .project {
    display: grid;
    gap: var(--space-5);
  }
  .project__text {
    display: grid;
    gap: var(--space-3);
    max-width: var(--max-text);
    align-content: start;
  }
  .project__name {
    font-size: var(--fs-h3);
  }
  .project__points {
    padding-left: 1.25em;
  }
  .project__points li + li {
    margin-top: var(--space-2);
  }
  .project__study {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--bg-2);
    border-radius: var(--radius);
  }
  .project__study-name {
    font-size: var(--fs-body);
  }
  .project__study-name .t-meta {
    font-weight: var(--fw-regular);
  }
  .project__link {
    font-weight: var(--fw-bold);
  }
  @media (min-width: 900px) {
    .project {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
