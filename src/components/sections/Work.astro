---
// Work.astro: section 4. The headline, then one stop per project (OurCityHealth, AI Simply,
// Civic AI Club), then the More work cards.
//
// Timeline hooks: each project is `data-stop="och|ais|club"` with `data-pin`; the More work
// cards are `data-stop="more"`. Layouts (media.css, V4.md 8.1 and 8.2):
//   - wide: the video large on the left, the text beside it.
//   - pin (wide, at least 600 tall) with motion on: each project is a 150vh track whose one-screen
//     frame (.stop__grid) stays still for 50vh (V4 section 2), in CSS; the timeline's held beats
//     count on those two numbers. The timeline adds .is-tall when an open More panel makes the
//     frame taller than the window; that project then scrolls normally.
//   - short (phones sideways): the video on the left, at most 70% of the window tall, the text
//     beside it.
//   - stack (phones and iPads upright): the video at full width, then the text.
// Not held (stack, short, reduced motion, wide windows under 600 tall) a project is as long as its
// content. Snapshot gives each one a screen of its own for the poster captures.
import LoopVideo from '../ui/LoopVideo.astro';
import More from '../ui/More.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { clipFor } from '../ui/previews';
import { work } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';
import { ui } from '../../data/site';

const headline = ignite(work.heading);
const moreHeadline = ignite(work.moreWork.heading);
---

<section id="work" class="work" data-scene="work" aria-labelledby="work-title">
  <div class="wrap work__head scrim">
    <h2 id="work-title" class="h2" {...headline.attrs} set:html={titleHtml(work.heading)} />
  </div>

  {
    work.projects.map((project) => (
      <article class="stop" data-stop={project.stop} data-pin aria-labelledby={`${project.stop}-name`}>
        <div class="wrap grid stop__grid">
          <LoopVideo class="stop__video" name={project.name} caption={project.caption} src={clipFor(project.previewId)} />
          <div class="stop__text stack scrim">
            <h3 id={`${project.stop}-name`} class="t-project" set:html={titleHtml(project.name)} />
            <p class="t-meta stop__role">{project.role.text}</p>
            <p class="t-lead">{project.lead.text}</p>
            <ul class="facts">
              {project.facts.map((fact) => (
                <li>{fact.text}</li>
              ))}
            </ul>
            <div class="stop__actions">
              <ExternalLink class="action-link" href={project.link.href} hint={project.name} arrow>
                {project.link.label}
              </ExternalLink>
              {project.more && (
                <More id={`${project.stop}-more`} label={ui.moreAbout(project.name)} class="stop__more">
                  {project.more.map((block) => (
                    <>
                      {block.head && (
                        <p>
                          <strong>{block.head.bold}</strong>
                          {block.head.rest && ` ${block.head.rest}`}
                        </p>
                      )}
                      {block.text && (
                        <p>
                          {block.title && <strong>{block.title}</strong>} {block.text.text}
                        </p>
                      )}
                      {block.list && (
                        <ul>
                          {block.list.map((item) => (
                            <li>{item.text}</li>
                          ))}
                        </ul>
                      )}
                    </>
                  ))}
                </More>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }

  <div class="more-work" data-stop="more">
    <div class="wrap scrim">
      <h3 class="more-work__title h2" {...moreHeadline.attrs} set:html={titleHtml(work.moreWork.heading)} />
      <ul class="more-work__list">
        {
          work.moreWork.items.map((item) => (
            <li class="card">
              <h4 class="card__name t-sub">{item.name}</h4>
              <p class="card__line">{item.line.text}</p>
              <ExternalLink class="action-link card__link" href={item.href} hint={item.name} arrow>
                {work.moreWork.linkLabel}
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  @import '../../styles/media.css';

  .work {
    position: relative;
    padding-block: 22vh;
    padding-block: round(nearest, 22vh, 8px);
  }
  @media (--wide) {
    .work {
      padding-top: 40vh;
      padding-bottom: 30vh;
      padding-top: round(nearest, 40vh, 8px);
      padding-bottom: round(nearest, 30vh, 8px);
    }
  }

  .work__head {
    margin-bottom: var(--space-7);
  }

  /* ---- A project stop ---- */
  .stop {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
  }
  @media (--short) {
    .stop {
      padding-block: var(--space-6);
    }
  }
  .stop__grid {
    row-gap: var(--space-5);
    align-items: center;
  }
  .stop__role {
    margin-top: var(--space-2) !important;
  }
  .stop__text .facts {
    margin-top: var(--space-4);
  }
  .stop__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-5);
    margin-top: var(--space-4) !important;
  }
  /* The More button sits beside the link; its panel opens on the line below. */
  .stop__actions :global(.stop__more) {
    display: contents;
  }
  .stop__actions :global(.more__panel) {
    flex-basis: 100%;
  }

  /* Stack: the video across the full width, the text under it at a reading width (upright iPads
     are wide enough for long lines otherwise). */
  @media (--stack) {
    .stop__text {
      max-width: 40rem;
    }
  }

  /* Short (phones sideways): the video on the left, never more than 70% of the window tall, so a
     whole frame is in view; the text beside it. Neither is held. */
  @media (--short) {
    .stop__grid :global(.stop__video) {
      grid-column: 1 / span 7;
      justify-self: start;
      width: 100%;
      /* The picture at most 70svh tall: its width, plus the frame's 16px mat and border. */
      max-width: calc(70vh * 1.6 + 16px);
      max-width: calc(70svh * 1.6 + 16px);
    }
    .stop__text {
      grid-column: 8 / span 5;
    }
  }

  /* Wide: the video large on the left, the text beside it. */
  @media (--wide) {
    .stop__grid :global(.stop__video) {
      grid-column: 1 / span 7;
    }
    .stop__text {
      grid-column: 8 / span 5;
    }
  }

  /*
    Held (the pin layout, motion on, JavaScript on, not snapshot): each project is a 150vh track
    whose frame (the grid) stays still for 50vh of scroll (V4 section 2), while the frames before
    and after it travel in and out over the other 100vh. The track's height is in the CSS from the
    first paint, so reloads and #links land in the right place and nothing moves when the scripts
    start. Small viewport units, so on an iPad the frame always fits what the toolbar leaves.
  */
  @media (--pin) {
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop:not(.is-tall) {
      height: 150vh;
      height: 150svh;
      padding-block: 0;
      align-items: flex-start;
    }
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop:not(.is-tall) .stop__grid {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      box-sizing: border-box;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
      align-content: center;
    }
    /* Keep the held frame inside the window on short windows. */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop__grid :global(.stop__video) {
      max-width: calc((100vh - var(--header-h) - 160px) * 1.6);
      max-width: calc((100svh - var(--header-h) - 160px) * 1.6);
      justify-self: start;
      width: 100%;
    }
  }

  /* Snapshot: every stop is one screen; "Selected work" rides at the top of the first one. */
  @media (--wide) {
    :global(html[data-snapshot]) .work {
      padding-block: 0;
    }
    :global(html[data-snapshot]) .work__head {
      position: absolute;
      top: var(--space-5);
      left: 0;
      right: 0;
      margin: 0;
    }
    /* min-height, not height: the timeline sets an inline height: auto on unpinned stops. */
    :global(html[data-snapshot]) .stop {
      min-height: 100vh;
      padding-block: var(--space-6);
    }
    :global(html[data-snapshot]) .stop[data-stop='och'] {
      padding-top: calc(var(--space-5) + var(--fs-h2) * 0.9 + var(--space-3));
      padding-bottom: var(--space-2);
    }
    :global(html[data-snapshot]) .more-work {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* ---- More work ---- */
  .more-work {
    position: relative;
    padding-block: var(--space-8);
  }
  @media (--wide) {
    .more-work {
      padding-block: var(--space-9);
    }
  }
  .more-work__title {
    margin-bottom: var(--space-5);
  }
  .more-work__list {
    display: grid;
    gap: var(--space-5);
  }
  /* Two cards: one under the other in the stack layout, side by side otherwise, each as wide as the
     work text column in the wide layout. */
  @media (--short), (--wide) {
    .more-work__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  @media (--wide) {
    .more-work__list {
      max-width: calc((100% - 11 * var(--space-5)) / 12 * 10 + 9 * var(--space-5));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .card__line {
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    /* Text color, not dim: the cards can scroll over the skyline. */
    color: var(--text);
    flex: 1;
  }
  .card__link {
    align-self: flex-start;
  }
</style>
