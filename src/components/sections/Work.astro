---
// Work.astro: section 4. The headline, then one stop per project (OurCityHealth, AI Simply,
// Civic AI Club), then the More work cards.
//
// Timeline hooks: each project is `data-stop="och|ais|club"` with `data-pin`; the More work
// cards are `data-stop="more"`. On desktop (1024px and up) with motion on, the timeline pins each
// project for about 120vh of scroll, so a project is exactly one viewport tall there: the video
// large on the left, the text beside it. Unpinned (reduced motion, snapshot, phones, tablets) the
// same layout simply scrolls, with the text under the video below 1024px.
import LoopVideo from '../ui/LoopVideo.astro';
import More from '../ui/More.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { clipFor } from '../ui/previews';
import { work } from '../../data/content';
import { ui } from '../../data/site';
---

<section id="work" class="work" data-scene="work" aria-labelledby="work-title">
  <div class="wrap work__head scrim">
    <h2 id="work-title" class="h2">{work.heading}</h2>
  </div>

  {
    work.projects.map((project) => (
      <article class="stop" data-stop={project.stop} data-pin aria-labelledby={`${project.stop}-name`}>
        <div class="wrap grid stop__grid">
          <LoopVideo class="stop__video" name={project.name} caption={project.caption} src={clipFor(project.previewId)} />
          <div class="stop__text stack scrim">
            <h3 id={`${project.stop}-name`} class="t-project">
              {project.name}
            </h3>
            <p class="t-small t-dim stop__role">{project.role.text}</p>
            <p class="t-lead">{project.lead.text}</p>
            <ul class="facts">
              {project.facts.map((fact) => (
                <li>{fact.text}</li>
              ))}
            </ul>
            <div class="stop__actions">
              <ExternalLink class="action-link" href={project.link.href} hint={project.name} arrow>
                {project.link.label}
              </ExternalLink>
              {project.more && (
                <More id={`${project.stop}-more`} label={ui.moreAbout(project.name)} class="stop__more">
                  {project.more.map((block) => (
                    <>
                      {block.text && (
                        <p>
                          {block.title && <strong>{block.title}</strong>} {block.text.text}
                        </p>
                      )}
                      {block.list && (
                        <ul>
                          {block.list.map((item) => (
                            <li>{item.text}</li>
                          ))}
                        </ul>
                      )}
                    </>
                  ))}
                </More>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }

  <div class="more-work" data-stop="more">
    <div class="wrap scrim">
      <h3 class="more-work__title t-sub">{work.moreWork.heading}</h3>
      <ul class="more-work__list">
        {
          work.moreWork.items.map((item) => (
            <li class="card">
              <h4 class="card__name">{item.name}</h4>
              <p class="card__line">{item.line.text}</p>
              <ExternalLink class="action-link card__link" href={item.href} hint={item.name} arrow>
                {work.moreWork.linkLabel}
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    padding-top: 22vh;
    padding-bottom: 22vh;
  }
  @media (min-width: 768px) {
    .work {
      padding-top: 40vh;
      padding-bottom: 30vh;
    }
  }

  .work__head {
    margin-bottom: var(--space-7);
  }

  /* ---- A project stop ---- */
  .stop {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
  }
  @media (min-width: 768px) {
    .stop {
      min-height: 120vh;
    }
  }
  .stop__grid {
    row-gap: var(--space-5);
    align-items: center;
  }
  .stop__role {
    margin-top: var(--space-2) !important;
  }
  .stop__text .facts {
    margin-top: var(--space-4);
  }
  .stop__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-5);
    margin-top: var(--space-4) !important;
  }
  /* The More button sits beside the link; its panel opens on the line below. */
  .stop__actions :global(.stop__more) {
    display: contents;
  }
  .stop__actions :global(.more__panel) {
    flex-basis: 100%;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .stop__grid :global(.stop__video),
    .stop__text {
      grid-column: 1 / -1;
    }
    .stop__text {
      max-width: 40rem;
    }
  }

  /* Desktop: the video large on the left, the text beside it. */
  @media (min-width: 1024px) {
    .stop__grid :global(.stop__video) {
      grid-column: 1 / span 7;
    }
    .stop__text {
      grid-column: 8 / span 5;
    }
    .stop__text .t-lead {
      font-size: var(--fs-lead);
    }
    /* Pinned (motion on, JavaScript on, not snapshot): exactly one viewport tall. */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop {
      height: 100vh;
      min-height: 0;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
    }
    /* Keep the pinned frame inside the viewport on short windows. */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop__grid :global(.stop__video) {
      max-width: calc((100vh - var(--header-h) - 160px) * 1.6);
      justify-self: start;
      width: 100%;
    }
  }

  /* ---- More work ---- */
  .more-work {
    position: relative;
    padding-block: var(--space-8);
  }
  @media (min-width: 768px) {
    .more-work {
      padding-block: var(--space-9);
    }
  }
  .more-work__title {
    margin-bottom: var(--space-5);
  }
  .more-work__list {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .more-work__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .card__name {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(20px, 1vw + 14px, 26px);
    line-height: 1.05;
    letter-spacing: var(--track-display);
  }
  .card__line {
    max-width: 40ch;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--dim);
    flex: 1;
  }
  .card__link {
    align-self: flex-start;
  }
</style>
