---
// Work.astro: section 4. The headline, then one stop per project (OurCityHealth, AI Simply,
// Civic AI Club), then the More work cards.
//
// Timeline hooks: each project is `data-stop="och|ais|club"` with `data-pin`; the More work
// cards are `data-stop="more"`. On desktop (1024px and up) with motion on, the timeline pins each
// project for about 120vh of scroll, so a project is exactly one viewport tall there: the video
// large on the left, the text beside it. Unpinned (reduced motion, snapshot, phones, tablets) the
// same layout simply scrolls, with the text under the video below 1024px.
import LoopVideo from '../ui/LoopVideo.astro';
import More from '../ui/More.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { clipFor } from '../ui/previews';
import { work } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';
import { ui } from '../../data/site';

const headline = ignite(work.heading);
const moreHeadline = ignite(work.moreWork.heading);
---

<section id="work" class="work" data-scene="work" aria-labelledby="work-title">
  <div class="wrap work__head scrim">
    <h2 id="work-title" class="h2" {...headline.attrs} set:html={titleHtml(work.heading)} />
  </div>

  {
    work.projects.map((project) => (
      <article class="stop" data-stop={project.stop} data-pin aria-labelledby={`${project.stop}-name`}>
        <div class="wrap grid stop__grid">
          <LoopVideo class="stop__video" name={project.name} caption={project.caption} src={clipFor(project.previewId)} />
          <div class="stop__text stack scrim">
            <h3 id={`${project.stop}-name`} class="t-project" set:html={titleHtml(project.name)} />
            <p class="t-meta stop__role">{project.role.text}</p>
            <p class="t-lead">{project.lead.text}</p>
            <ul class="facts">
              {project.facts.map((fact) => (
                <li>{fact.text}</li>
              ))}
            </ul>
            <div class="stop__actions">
              <ExternalLink class="action-link" href={project.link.href} hint={project.name} arrow>
                {project.link.label}
              </ExternalLink>
              {project.more && (
                <More id={`${project.stop}-more`} label={ui.moreAbout(project.name)} class="stop__more">
                  {project.more.map((block) => (
                    <>
                      {block.head && (
                        <p>
                          <strong>{block.head.bold}</strong>
                          {block.head.rest && ` ${block.head.rest}`}
                        </p>
                      )}
                      {block.text && (
                        <p>
                          {block.title && <strong>{block.title}</strong>} {block.text.text}
                        </p>
                      )}
                      {block.list && (
                        <ul>
                          {block.list.map((item) => (
                            <li>{item.text}</li>
                          ))}
                        </ul>
                      )}
                    </>
                  ))}
                </More>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }

  <div class="more-work" data-stop="more">
    <div class="wrap scrim">
      <h3 class="more-work__title h2" {...moreHeadline.attrs} set:html={titleHtml(work.moreWork.heading)} />
      <ul class="more-work__list">
        {
          work.moreWork.items.map((item) => (
            <li class="card">
              <h4 class="card__name t-sub">{item.name}</h4>
              <p class="card__line">{item.line.text}</p>
              <ExternalLink class="action-link card__link" href={item.href} hint={item.name} arrow>
                {work.moreWork.linkLabel}
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    padding-block: 22vh;
    padding-block: round(nearest, 22vh, 8px);
  }
  @media (min-width: 768px) {
    .work {
      padding-top: 40vh;
      padding-bottom: 30vh;
      padding-top: round(nearest, 40vh, 8px);
      padding-bottom: round(nearest, 30vh, 8px);
    }
  }

  .work__head {
    margin-bottom: var(--space-7);
  }

  /* ---- A project stop ---- */
  .stop {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
  }
  @media (min-width: 768px) {
    .stop {
      min-height: 120vh;
    }
  }
  .stop__grid {
    row-gap: var(--space-5);
    align-items: center;
  }
  .stop__role {
    margin-top: var(--space-2) !important;
  }
  .stop__text .facts {
    margin-top: var(--space-4);
  }
  .stop__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-5);
    margin-top: var(--space-4) !important;
  }
  /* The More button sits beside the link; its panel opens on the line below. */
  .stop__actions :global(.stop__more) {
    display: contents;
  }
  .stop__actions :global(.more__panel) {
    flex-basis: 100%;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .stop__grid :global(.stop__video),
    .stop__text {
      grid-column: 1 / -1;
    }
    .stop__text {
      max-width: 40rem;
    }
  }

  /* Desktop: the video large on the left, the text beside it. */
  @media (min-width: 1024px) {
    .stop__grid :global(.stop__video) {
      grid-column: 1 / span 7;
    }
    .stop__text {
      grid-column: 8 / span 5;
    }
    .stop__text .t-lead {
      font-size: var(--fs-lead);
    }
    /*
      Held (motion on, JavaScript on, not snapshot): each project is a 220vh track whose frame
      (the grid) stays still for 120vh of scroll (spec section 6). The track's height is in the
      CSS from the first paint, so reloads and #links land in the right place and nothing moves
      when the scripts start. The timeline adds .is-tall when an open More panel makes the frame
      taller than the window; that project then scrolls normally.
    */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop:not(.is-tall) {
      height: 220vh;
      min-height: 0;
      padding-block: 0;
      align-items: flex-start;
    }
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop:not(.is-tall) .stop__grid {
      position: sticky;
      top: 0;
      height: 100vh;
      box-sizing: border-box;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
      align-content: center;
    }
    /* Keep the pinned frame inside the viewport on short windows. */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .stop__grid :global(.stop__video) {
      max-width: calc((100vh - var(--header-h) - 160px) * 1.6);
      justify-self: start;
      width: 100%;
    }
  }

  /* Snapshot: every stop is one screen; "Selected work" rides at the top of the first one. */
  @media (min-width: 1024px) {
    :global(html[data-snapshot]) .work {
      padding-block: 0;
    }
    :global(html[data-snapshot]) .work__head {
      position: absolute;
      top: var(--space-5);
      left: 0;
      right: 0;
      margin: 0;
    }
    /* min-height, not height: the timeline sets an inline height: auto on unpinned stops. */
    :global(html[data-snapshot]) .stop {
      min-height: 100vh;
      padding-block: var(--space-6);
    }
    :global(html[data-snapshot]) .stop[data-stop='och'] {
      padding-top: calc(var(--space-5) + var(--fs-h2) * 0.9 + var(--space-3));
      padding-bottom: var(--space-2);
    }
    :global(html[data-snapshot]) .more-work {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* ---- More work ---- */
  .more-work {
    position: relative;
    padding-block: var(--space-8);
  }
  @media (min-width: 768px) {
    .more-work {
      padding-block: var(--space-9);
    }
  }
  .more-work__title {
    margin-bottom: var(--space-5);
  }
  .more-work__list {
    display: grid;
    gap: var(--space-5);
  }
  /* Two cards: side by side from 768px, each as wide as the work text column on desktop. */
  @media (min-width: 768px) {
    .more-work__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  @media (min-width: 1024px) {
    .more-work__list {
      max-width: calc((100% - 11 * var(--space-5)) / 12 * 10 + 9 * var(--space-5));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .card__line {
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    /* Text color, not dim: the cards can scroll over the skyline. */
    color: var(--text);
    flex: 1;
  }
  .card__link {
    align-self: flex-start;
  }
</style>
