---
// Experience.astro: section 3. Civic Exchange first with the full block (place, meta, lead, four
// facts, and the full summer section from the long copy behind More), then the two Wisers
// summers, one line each with their meta.
//
// The archive (NIGHT-SIGNAL.md 11b.3): the twelve columns of light the signal raises over Central
// are sized by the notebooks' real document counts. Screen readers get the same data as a
// visually hidden list under the "12 searchable notebooks" fact. The small label the lead's
// interact.ts shows over a hovered or tapped column is `[data-archive-label]`: it sets the text,
// `hidden`, and left/top in viewport pixels (the column's top); the CSS centers it just above.
import More from '../ui/More.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { archive, experience } from '../../data/content';
import { ignite } from '../ui/ignite';

const { civic, roles } = experience;
const headline = ignite(experience.heading);
---

<section id="experience" class="scene xp" data-scene="experience" aria-labelledby="experience-title">
  <div class="wrap grid">
    <div class="xp__block scrim">
      <div class="xp__main">
        <h2 id="experience-title" class="h2" {...headline.attrs} set:html={headline.html} />
        <div class="xp__civic stack">
          <div class="xp__where">
            <h3 class="t-sub">{civic.name}</h3>
            <p class="t-meta">{civic.meta.text}</p>
          </div>
          <p class="t-lead">{civic.lead.text}</p>
          <ul class="facts">
            {
              civic.facts.map((fact) => (
                <li>
                  {fact.text}
                  {fact.archive && (
                    <ul class="sr-only">
                      {archive.columns.map((col) => (
                        <li>{archive.label(col.topic, col.count)}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <More id="experience-more" label={civic.moreLabel} class="xp__more">
        {
          civic.more.map((block) => (
            <>
              {block.text && (
                <p>
                  <strong>{block.title}</strong> {block.text.text}
                </p>
              )}
              {block.list && (
                <>
                  <p>
                    <strong>{block.title}</strong>
                  </p>
                  <ul>
                    {block.list.map((item) => (
                      <li>{item.text}</li>
                    ))}
                  </ul>
                </>
              )}
            </>
          ))
        }
      </More>

      <ul class="xp__roles">
        {
          roles.map((role) => (
            <li class="xp__role">
              <h3 class="t-sub xp__role-name">{role.name}</h3>
              <p class="t-meta">{role.meta.text}</p>
              <p class="t-body xp__role-line">{role.line.text}</p>
              {role.link && (
                <p>
                  <ExternalLink class="action-link" href={role.link.href} arrow>
                    {role.link.label}
                  </ExternalLink>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="archive-label" data-archive-label aria-hidden="true" hidden></p>
</section>

<style>
  .xp {
    --scene-h: 140vh;
  }
  .xp__civic {
    margin-top: var(--space-5);
  }
  .xp__where {
    display: grid;
    gap: var(--space-2);
  }
  .xp .facts {
    margin-top: var(--space-4);
  }
  .xp :global(.xp__more) {
    margin-top: var(--space-3);
  }

  /* The two Wisers summers: one line each, under a hairline. */
  .xp__roles {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .xp__role {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .xp__role-name {
    font-size: clamp(22px, 0.4vw + 20.5px, 26px);
  }
  .xp__role-line {
    margin-top: var(--space-1);
  }
  .xp__role .action-link {
    margin-top: calc(var(--space-2) * -1);
  }

  /* The column label: fixed to the window, centered just above the point interact.ts gives it (the
     column's top), over everything in the page but under the header. Text color with the strong
     halo and a small scrim of its own, since it sits right over the brightest light on screen. */
  .archive-label {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2;
    margin: 0;
    transform: translate(-50%, calc(-100% - 8px));
    pointer-events: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    color: var(--c-body);
    white-space: nowrap;
    text-shadow: var(--halo-strong);
  }
  .archive-label[hidden] {
    display: none;
  }
  .archive-label::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-2) * -1) calc(var(--space-4) * -1);
    z-index: -1;
    background: var(--scrim-hug);
  }

  /* Phones (and portrait tablets, the phone layout): the twelve columns fill the band from about
     15% to 52% of the screen while this section scrolls, and the full-width text covers them.
     About 55vh of empty world at the end lets the text clear the band before Selected work
     comes in below it. */
  @media (max-width: 767px) {
    .xp {
      padding-bottom: calc(22vh + 55vh);
      padding-bottom: round(nearest, 77vh, 8px);
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) and (orientation: portrait) {
    .xp {
      padding-bottom: calc(var(--space-9) + 55vh);
      padding-bottom: calc(var(--space-9) + round(nearest, 55vh, 8px));
    }
  }

  /* Desktop: the right column (the same edge as the work text), clear of the archive rising
     over Central, left of center. */
  @media (min-width: 1024px) {
    .xp__block {
      grid-column: 8 / span 5;
    }
  }

  /* Snapshot: one screen. The headline across the top; the short copy on the left (columns 1 to
     4) with the long copy beside it in three columns; the two Wisers summers side by side along
     the bottom. */
  @media (min-width: 1024px) {
    :global(html[data-snapshot]) .xp {
      padding-block: var(--space-5);
    }
    :global(html[data-snapshot]) .xp__block {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: start;
    }
    :global(html[data-snapshot]) .xp__main {
      display: contents;
    }
    :global(html[data-snapshot]) .xp__main > .h2 {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    :global(html[data-snapshot]) .xp__civic {
      grid-column: 1 / span 4;
      grid-row: 2;
      margin-top: var(--space-3);
    }
    :global(html[data-snapshot]) .xp__block > :global(.xp__more) {
      grid-column: 5 / span 8;
      grid-row: 2;
      margin-top: var(--space-3);
    }
    :global(html[data-snapshot]) .xp :global(.more__inner) {
      columns: 3;
      column-gap: var(--space-4);
      padding-top: 0;
      padding-bottom: 0;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner p),
    :global(html[data-snapshot]) .xp :global(.more__inner li) {
      font-size: 15px;
      line-height: 1.55;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner p:has(+ ul)) {
      break-after: avoid;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner li) {
      break-inside: avoid;
    }
    :global(html[data-snapshot]) .xp__roles {
      grid-column: 1 / -1;
      grid-row: 3;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
      margin-top: var(--space-3);
    }
    :global(html[data-snapshot]) .xp__role {
      padding-top: var(--space-3);
    }
  }
</style>
