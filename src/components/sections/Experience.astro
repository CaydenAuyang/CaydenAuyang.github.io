---
// Experience.astro: section 3. Civic Exchange first with the full block (place, meta, the
// supervisor line, lead, four facts, and the full summer section from the long copy behind More),
// then Wisers: one entry with two summers, 2024 first.
//
// Civic Exchange (`.xp__track`): where sections are held (the pin layout: wide, at least 600 tall;
// V4.md 8.1) with motion on, a track whose one-screen frame (`.xp__wrap`) holds still for about
// 70vh once the twelve columns stand, so the whole block can be read with the columns still beside
// it (V4 section 1). The timeline lets go (`.is-tall`) while an open More panel makes the block
// taller than the window. Side by side (short and wide) the block is the right column, clear of
// the columns in the left half. In the stack layout (phones, upright iPads) the columns stand
// across the upper half and the block scrolls up from below, after half a screen of sky in which
// they form; as the text reaches the columns' feet it fades out (src/scripts/civic.ts), so the
// columns sit above the text, never behind it (V4.md 8.2).
//
// The archive (NIGHT-SIGNAL.md 11b.3): the twelve columns of light the signal raises over Central
// are sized by the notebooks' real document counts. Screen readers get the same data as a
// visually hidden list under the "12 searchable notebooks" fact. The small label the lead's
// interact.ts shows over a hovered or tapped column is `[data-archive-label]`: it sets the text,
// `hidden`, and left/top in viewport pixels (the column's top); the CSS centers it just above.
//
// Wisers (`data-scene="wisers"`): in the pin layout (motion on or off), a tall track whose
// one-screen frame holds still for about 160vh of scroll while the signal draws the 2024 feed and
// shoe, then the 2025 screen agent, inside WISERS_ANCHOR (contract.ts). Elsewhere nothing is held
// (V4.md 8.2): the block scrolls, and the timeline draws each picture while its summer's line is
// being read (it starts those scenes at the [data-summer] lines, and treats a sticky frame as
// held). The text keeps out of that box: the right column side by side (short and wide); in the
// stack layout the pictures sit above and the text is cut off as it reaches their bottom edge
// (src/scripts/wisers.ts). The timeline sets data-beat="2024" or "2025" on the track; that
// summer's label lights and the other dims (with no attribute both read evenly). Snapshot: the
// track is two screens with the frame held, one per summer.
import More from '../ui/More.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { archive, experience } from '../../data/content';
import { ignite } from '../ui/ignite';
import { titleHtml } from '../ui/title';

const { civic, wisers } = experience;
const headline = ignite(experience.heading);
---

<section id="experience" class="scene xp" data-scene="experience" aria-labelledby="experience-title">
  <div class="xp__track">
    <div class="wrap grid xp__wrap">
      <div class="xp__block scrim">
        <div class="xp__main">
          <h2 id="experience-title" class="h2" {...headline.attrs} set:html={titleHtml(experience.heading)} />
          <div class="xp__civic stack">
            <div class="xp__where">
              <h3 class="t-project xp__org" set:html={titleHtml(civic.name, 'Civic Exchange')} />
              <p class="t-meta">{civic.meta.text}</p>
              <p class="t-meta xp__supervisor">{civic.supervisor.text}</p>
            </div>
            <p class="t-lead">{civic.lead.text}</p>
            <ul class="facts">
              {
                civic.facts.map((fact) => (
                  <li>
                    {fact.text}
                    {fact.archive && (
                      <ul class="sr-only">
                        {archive.columns.map((col) => (
                          <li>{archive.label(col.topic, col.count)}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <More id="experience-more" label={civic.moreLabel} class="xp__more">
          {
            civic.more.map((block) => (
              <>
                {block.text && (
                  <p>
                    <strong>{block.title}</strong> {block.text.text}
                  </p>
                )}
                {block.list && (
                  <>
                    <p>
                      <strong>{block.title}</strong>
                    </p>
                    <ul>
                      {block.list.map((item) => (
                        <li>{item.text}</li>
                      ))}
                    </ul>
                  </>
                )}
              </>
            ))
          }
        </More>
      </div>
    </div>
  </div>

  <div class="wisers" data-scene="wisers">
    <div class="wisers__frame">
      <div class="wrap grid">
        <div class="wisers__block scrim">
          <h3 class="t-project xp__org" set:html={titleHtml(wisers.name, 'Wisers')} />
          <p class="t-meta">{wisers.meta.text}</p>
          <ol class="wisers__summers">
            {
              wisers.summers.map((summer) => (
                <li class="wisers__summer" data-summer={summer.beat}>
                  <h4 class="wisers__label">{summer.label}</h4>
                  <p class="t-body">{summer.line.text}</p>
                  {summer.link && (
                    <p>
                      <ExternalLink class="action-link" href={summer.link.href} arrow>
                        {summer.link.label}
                      </ExternalLink>
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>

  <p class="archive-label" data-archive-label aria-hidden="true" hidden></p>
</section>

<script>
  import '../../scripts/civic';
  import '../../scripts/wisers';
</script>

<style>
  @import '../../styles/media.css';

  .xp {
    --scene-h: 140vh;
  }
  .xp__civic {
    margin-top: var(--space-5);
  }
  .xp__where {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }
  /* The Civic Exchange header rises through the Mission current's densest band while the columns
     form (C to D), and the block's own scrim fades out toward its top. A denser scrim of its own
     keeps the meta and supervisor lines at 4.5:1 over the stream (they measured 2.1 to 2.5). */
  .xp__where::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-4) * -1) calc(var(--space-6) * -1);
    z-index: -1;
    background: var(--scrim-dense);
    pointer-events: none;
  }
  .xp__supervisor {
    max-width: var(--measure);
  }
  .xp .facts {
    margin-top: var(--space-4);
  }
  .xp :global(.xp__more) {
    margin-top: var(--space-3);
  }

  /* The column label: fixed to the window, centered just above the point interact.ts gives it (the
     column's top), over everything in the page but under the header. Text color with the strong
     halo and a small scrim of its own, since it sits right over the brightest light on screen. */
  .archive-label {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2;
    margin: 0;
    transform: translate(-50%, calc(-100% - 8px));
    pointer-events: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    color: var(--c-body);
    white-space: nowrap;
    text-shadow: var(--halo-strong);
  }
  .archive-label[hidden] {
    display: none;
  }
  .archive-label::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-2) * -1) calc(var(--space-4) * -1);
    z-index: -1;
    background: var(--scrim-hug);
  }

  /* Stack (phones and upright iPads): the twelve columns stand across the band from 13% to 55% of
     the screen. Half a screen of sky above the block (instead of the scenes' 22vh) lets them form
     before EXPERIENCE comes up under them, and as the text reaches their feet it fades out
     (civic.ts), its band of night with it. The frame's box reaches 160px past the block above and
     below, as that band does (base.css), so the fade's mask covers all of it; the negative margins
     keep everything where it was. About 55vh of empty world after it lets the text clear the band
     before Wisers comes in. */
  @media (--stack) {
    .xp {
      padding-top: 50vh;
      padding-top: round(nearest, 50vh, 8px);
    }
    .xp__wrap {
      padding-block: 160px;
      margin-top: -160px;
      margin-bottom: calc(55vh - 160px);
      margin-bottom: calc(round(nearest, 55vh, 8px) - 160px);
    }
    /* civic.ts keeps taps off the faded part, but a keyboard still reaches More there. When it
       takes focus the browser scrolls it into view counting this margin, so it lands below the
       fade (the line at 55% of the canvas plus 8px, then 48px of fade), not under the columns. */
    :global(html:not(.no-webgl):not(.world-lost)) .xp :global(.xp__more .more__btn) {
      scroll-margin-top: calc(55 * var(--lvh) + 64px);
    }
  }

  /* Side by side (short and wide): Civic Exchange is the right column (the same edge as the work
     text), clear of the archive rising over Central in the left half (x 0.09 to 0.52 of the window
     at 852 x 393 and 1440 x 900 alike). Its scrim stops short of the columns: it is masked off from
     13% of the block's width left of the text (about 0.54 of the window at 1024 to 1440, 0.53 at
     1920, 0.55 at 852) and fades in to full by the text's edge, so it never dims some columns and
     not others. */
  @media (--short), (--wide) {
    .xp__block {
      grid-column: 8 / span 5;
    }
    .xp__block.scrim::before {
      /* The pseudo is 2.6 block widths wide; the block starts at 0.8 / 2.6 = 30.77% of it. */
      -webkit-mask-image: linear-gradient(to right, transparent 25.77%, #000 30.77%);
      mask-image: linear-gradient(to right, transparent 25.77%, #000 30.77%);
    }
  }
  /* Side by side: Wisers in the same right column, clear of its pictures (WISERS_ANCHOR, left sky,
     x 0.1 to 0.5), its scrim masked the same way. */
  @media (--short), (--wide) {
    .wisers__block {
      grid-column: 8 / span 5;
    }
    .wisers__block.scrim::before {
      -webkit-mask-image: linear-gradient(to right, transparent 25.77%, #000 30.77%);
      mask-image: linear-gradient(to right, transparent 25.77%, #000 30.77%);
    }
  }

  /*
    Civic Exchange held (the pin layout: wide and at least 600 tall; motion on, JavaScript on, not
    snapshot; V4 section 1): a 170vh track whose one-screen frame stays still for 70vh of scroll
    once the twelve columns stand, the block centered in it, as Wisers and the work stops are held.
    The track's height is in the CSS from the first paint. The timeline adds .is-tall while an open
    More panel makes the block taller than the frame; then it scrolls normally. The frame keeps its
    padding either way, so the timeline's fit test reads the same held or not. The frame is one
    small viewport tall, so on an iPad the toolbar never pushes the block out of it. Stack, short,
    reduced motion and snapshot don't hold.
  */
  @media (--pin) {
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__wrap {
      box-sizing: border-box;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
    }
    /* The menu and the lift land where the hold starts (the track's top, under the section's top
       padding): Civic Exchange in its frame with the columns whole. */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp {
      scroll-margin-top: calc(var(--space-9) * -1);
    }
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__track:not(.is-tall) {
      height: 170vh;
    }
    /* Let go, the block keeps the place it had in the frame (set by the timeline). */
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__track.is-tall .xp__wrap {
      padding-top: var(--civic-top, calc(var(--header-h) + var(--space-3)));
    }
    :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__track:not(.is-tall) .xp__wrap {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      align-content: center;
    }
    /* Short windows (1024 x 768, 1280 x 720, iPads sideways): a tighter frame and one smaller gap,
       so the block (about 680px at 1024 wide) still fits and holds. */
    @media (max-height: 820px) {
      :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__wrap {
        padding-block: calc(var(--header-h) + var(--space-2)) var(--space-3);
      }
      :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__track.is-tall .xp__wrap {
        padding-top: var(--civic-top, calc(var(--header-h) + var(--space-2)));
      }
      :global(html.js:not([data-motion='off']):not([data-snapshot])) .xp__civic {
        margin-top: var(--space-4);
      }
    }
  }

  /* ---- Wisers: one entry, two summers ---- */
  .wisers {
    position: relative;
    margin-top: var(--space-8);
  }
  .wisers__frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .wisers__block > .t-meta {
    margin-top: var(--space-2);
  }
  .wisers__summers {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  /* Stack: tighter, so snapshot's held frame fits under the pictures (below 0.48 of the height),
     and at a reading width on upright iPads. Not held, the two summers sit a quarter of a screen
     apart, so each line is read while its pictures draw and hold (the timeline's wisers2024 and
     wisers2025 scenes start at the lines): the 2024 line reaches the pictures' edge as the 2025
     line is a quarter of the way up, where the screen agent starts. */
  @media (--stack) {
    .wisers__block {
      max-width: 40rem;
    }
    .wisers__summers {
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    :global(html:not([data-snapshot])) .wisers__summers {
      gap: 25vh;
      gap: 25svh;
    }
    .wisers__summer {
      gap: var(--space-1);
    }
    .wisers__block > .t-meta {
      margin-top: var(--space-1);
    }
  }
  .wisers__summer {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
  }
  /* A small lamp beside each summer; the one the signal is drawing lights up. */
  .wisers__summer::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.1em;
    width: 3px;
    height: 1.4em;
    border-radius: 2px;
    background: var(--rule);
    transition:
      background 400ms var(--ease-out),
      box-shadow 400ms var(--ease-out);
  }
  .wisers__label {
    font-family: var(--font-display);
    font-size: var(--fs-summer);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--c-sub);
    transition: color 400ms var(--ease-out);
  }
  /* The timeline's beat: that summer lit, the other's label dimmed. The lines stay in text color, so
     both stay readable. */
  .wisers[data-beat] .wisers__label {
    color: var(--c-meta);
  }
  .wisers[data-beat='2024'] [data-summer='2024'] .wisers__label,
  .wisers[data-beat='2025'] [data-summer='2025'] .wisers__label {
    color: var(--window);
  }
  .wisers[data-beat='2024'] [data-summer='2024']::before,
  .wisers[data-beat='2025'] [data-summer='2025']::before {
    background: var(--window);
    box-shadow: 0 0 10px rgb(var(--window-rgb) / 0.7);
  }

  /* Held (the pin layout, with JavaScript, motion on or off: holding still isn't motion): a 260vh
     track whose one-screen frame stays still for 160vh of scroll, like the work stops, so each
     picture gets its time, the text centered in the right column. The timeline reads a sticky
     frame as held. Snapshot holds it in every layout, over two screens (below). */
  :global(html[data-snapshot]) .wisers__frame {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
  }
  @media (--pin) {
    :global(html.js:not([data-snapshot])) .wisers {
      height: 260vh;
      height: 260svh;
    }
    :global(html.js:not([data-snapshot])) .wisers__frame {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      min-height: 0;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-5);
    }
  }
  /* Stack, snapshot: the text at the bottom of the screen, below the pictures (WISERS_ANCHOR.phone
     ends at 0.48 of the height). */
  @media (--stack) {
    :global(html[data-snapshot]) .wisers__frame {
      justify-content: flex-end;
      padding-top: calc(48vh + var(--space-3));
      padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    }
    /* Stack, not held: the block scrolls up under the pictures and wisers.ts cuts it off at their
       bottom edge with a mask on the frame. The frame's box reaches 160px past the block above and
       below, as the block's band of night does (base.css), so the mask covers all of it; the
       negative margins (inside a flow root, so they don't collapse outward) keep everything where
       it was. */
    :global(html:not([data-snapshot])) .wisers {
      display: flow-root;
    }
    :global(html:not([data-snapshot])) .wisers__frame {
      padding-block: 160px;
      margin-block: -160px;
    }
  }
  /* Printing: no held track and no screen-sized spacing (either would print an empty page). The
     phone layout's room for the archive band and the Wisers frame's screen height and room for
     the pictures are for the world, which doesn't print; the text follows on. */
  @media print {
    /* A block, not the page grid: as a grid item split over pages, Civic Exchange left a blank
       page at the end of the print (Chrome, A4 landscape from a phone). On wide paper it keeps its
       right column (8 to 12) by margin. */
    .xp__wrap {
      display: block !important;
      margin-block: 0 !important;
      position: static !important;
      height: auto !important;
      padding-block: 0 !important;
    }
    .xp__track {
      height: auto !important;
    }
    /* Snapshot's two desktop screens (below) are for captures: on wide paper they centred the
       block in 200vh and left the section's first page blank. */
    .xp__block {
      display: block !important;
      min-height: 0 !important;
    }
    .xp__main {
      margin-block: 0 !important;
    }
    .xp :global(.xp__more) {
      margin-top: var(--space-3) !important;
    }
    .wisers {
      height: auto !important;
      margin-top: var(--space-6) !important;
    }
    .wisers__frame {
      position: static !important;
      height: auto !important;
      min-height: 0 !important;
      padding: 0 !important;
      margin-block: 0 !important;
      justify-content: flex-start !important;
      -webkit-mask-image: none !important;
      mask-image: none !important;
    }
    .wisers__summers {
      gap: var(--space-3) !important;
    }
  }
  @media print and (min-width: 1024px) {
    .xp__block {
      width: calc((100% - 11 * var(--space-5)) / 12 * 5 + 4 * var(--space-5));
      margin-left: calc((100% - 11 * var(--space-5)) / 12 * 7 + 7 * var(--space-5));
    }
  }
  /* Snapshot: two screens, the frame held across both (2024, then 2025). */
  :global(html[data-snapshot]) .wisers {
    height: 200vh;
    margin-top: 0;
  }
  /* Short, snapshot: the held frame is a phone held sideways, too short for both summers, so each
     of the two screens shows its own summer under the name (by the timeline's beat), and the frame
     drops the header's room (snapshot has no header). On screen only: paper shows both. */
  @media (--short) {
    @media screen {
      :global(html[data-snapshot]) .wisers__frame {
        padding-block: var(--space-3);
      }
      :global(html[data-snapshot]) .wisers:not([data-beat='2025']) [data-summer='2025'],
      :global(html[data-snapshot]) .wisers[data-beat='2025'] [data-summer='2024'] {
        display: none;
      }
    }
  }
  /* Side by side and not held (no JavaScript, phones sideways, wide windows under 600 tall): one
     screen of its own in the flow. */
  @media (--short), (--wide) {
    .wisers__frame {
      min-height: 100vh;
    }
  }
  /* Short (phones sideways), not held: the window is too short to read both summers while their
     pictures draw beside them, so the lines come up one at a time. The 2024 line is half gone at
     the top as the 2025 line is a quarter of the way up, where the screen agent starts (the
     timeline's wisers2025), and the 2025 line is half gone by the time SELECTED WORK comes up and
     the screen agent leaves (the work beat). */
  @media (--short) {
    :global(html:not([data-snapshot])) .wisers__summers {
      gap: 58vh;
      gap: 58svh;
    }
    :global(html:not([data-snapshot])) .wisers__frame {
      padding-bottom: 30vh;
      padding-bottom: 30svh;
    }
  }

  /*
    Snapshot (wide): Civic Exchange takes two screens. The first is the live layout: the chart
    clear on the left, the headline and the Civic Exchange short copy on the right, centered. The
    second holds the open More text, in two columns in the same right column, so the chart stays
    clear there too. The block's scrim becomes a band down the right side (feathered over 120px at
    the top and bottom, masked off on the left as live). Wisers follows in two screens.
  */
  @media (--wide) {
    :global(html[data-snapshot]) .xp {
      padding-block: 0;
    }
    :global(html[data-snapshot]) .xp__block {
      display: flex;
      flex-direction: column;
      min-height: 200vh;
    }
    :global(html[data-snapshot]) .xp__block.scrim::before {
      inset: 0 -80%;
      background: linear-gradient(
        to bottom,
        rgb(var(--night-rgb) / 0) 0,
        rgb(var(--night-rgb) / 0.6) 120px,
        rgb(var(--night-rgb) / 0.6) calc(100% - 120px),
        rgb(var(--night-rgb) / 0) 100%
      );
    }
    :global(html[data-snapshot]) .xp__main {
      margin-block: auto;
    }
    :global(html[data-snapshot]) .xp__block > :global(.xp__more) {
      min-height: 100vh;
      margin-top: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner) {
      columns: 2;
      column-gap: var(--space-5);
      padding-block: 0;
    }
    /* Under 1280px the right column is too narrow for two columns of text. */
    @media (max-width: 1279px) {
      :global(html[data-snapshot]) .xp :global(.more__inner) {
        columns: 1;
      }
    }
    :global(html[data-snapshot]) .xp :global(.more__inner p),
    :global(html[data-snapshot]) .xp :global(.more__inner li) {
      font-size: 15px;
      line-height: 1.55;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner p:has(+ ul)) {
      break-after: avoid;
    }
    :global(html[data-snapshot]) .xp :global(.more__inner li) {
      break-inside: avoid;
    }
  }
</style>
