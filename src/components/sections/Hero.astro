---
// Hero.astro: the name, one line, one small line, and the scroll cue, over the dark sky.
//
// The layout follows the world contract (src/world/contract.ts), so the text never sits on the
// figure of light or the skyline. The phone layout is usePhoneLayout(): phones, plus portrait
// screens under 1024px wide (portrait tablets). Its CSS twin, used below and in base.css:
//   phone:    @media (max-width: 767px), (max-width: 1023px) and (orientation: portrait)
//   desktop:  @media (min-width: 1024px), (min-width: 768px) and (orientation: landscape)
//   - desktop: the figure sits right of center (FIGURE_ANCHOR.desktop), so the text sits to its
//     left, in the left ~45% of the width, ending above the tower tops
//     (HERO_FRAMING.desktop.skylineTop).
//   - phone: the figure sits high in the middle (FIGURE_ANCHOR.phone), so the text sits below
//     it and above the tower tops (HERO_FRAMING.phone.skylineTop).
// The anchors arrive as CSS custom properties; a soft radial scrim sits behind the text.
//
// Timeline hooks: data-intro="name|line|small" (masked under html.js-intro until the timeline
// adds .is-in; revealed after 2.5 s regardless), data-scroll-cue (the timeline adds .is-gone on
// the first scroll). The figure's description is a role="img" box at the figure's place, shown
// to assistive tech only once the world (or its still) is drawn.
import { FIGURE_ANCHOR, HERO_FRAMING, PHONE_MAX_WIDTH, usePhoneLayout } from '../../world/contract';
import { hero, meta } from '../../data/content';

// The CSS mirrors usePhoneLayout() with media queries. If the contract's rule moves, stop the
// build so the queries get updated with it.
const layoutCases: [number, number, boolean][] = [
  [390, 844, true],
  [767, 500, true],
  [768, 1024, true],
  [1023, 1366, true],
  [1023, 700, false],
  [768, 600, false],
  [1024, 1366, false],
  [1440, 900, false],
];
if (PHONE_MAX_WIDTH !== 767 || layoutCases.some(([w, h, phone]) => usePhoneLayout(w, h) !== phone)) {
  throw new Error('Hero.astro: usePhoneLayout() in contract.ts changed; update the phone/desktop media queries in the Pages CSS.');
}

const d = FIGURE_ANCHOR.desktop;
const p = FIGURE_ANCHOR.phone;
const vars = [
  `--fig-x-d: ${d.x}`,
  `--fig-y-d: ${d.y}`,
  `--fig-h-d: ${d.height}`,
  `--fig-x-p: ${p.x}`,
  `--fig-y-p: ${p.y}`,
  `--fig-h-p: ${p.height}`,
  `--sky-top-d: ${HERO_FRAMING.desktop.skylineTop}`,
  `--sky-top-p: ${HERO_FRAMING.phone.skylineTop}`,
].join('; ');
---

<section id="hero" class="hero" data-scene="hero" aria-labelledby="hero-name" style={vars}>
  <div class="hero__figure" role="img" aria-label={meta.figureAlt}></div>

  <div class="hero__text scrim scrim--soft">
    <h1 id="hero-name" class="hero__name t-display" data-intro="name">
      {
        hero.nameLines.map((line, i) => (
          <>
            {i > 0 && ' '}
            <span class="hero__name-line">{line}</span>
          </>
        ))
      }
    </h1>
    <p class="hero__line" data-intro="line">{hero.line.text}</p>
    <p class="hero__small" data-intro="small">{hero.small.text}</p>
  </div>

  <div class="hero__cue" data-scroll-cue data-snapshot-hide aria-hidden="true">
    <span>{hero.scrollCue}</span>
    <span class="hero__cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
  }

  /* Where the figure of light is drawn: a box for its description, invisible. */
  .hero__figure {
    position: absolute;
    left: calc(var(--fig-x-p) * 100%);
    top: calc(var(--fig-y-p) * 100%);
    height: calc(var(--fig-h-p) * 100%);
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: none;
  }
  :global(html.is-ready) .hero__figure,
  :global(html:has([data-world-fallback][data-still])) .hero__figure {
    display: block;
  }

  /* Phone: under the figure, above the tower tops. */
  .hero__text {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc((var(--fig-y-p) + var(--fig-h-p) / 2) * 100% + var(--space-3));
  }
  .hero__name {
    font-size: var(--fs-name);
    font-weight: var(--fw-display-heavy);
  }
  .hero__name-line {
    display: block;
  }
  .hero__line {
    margin-top: var(--space-3);
    max-width: 30ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .hero__small {
    margin-top: var(--space-2);
    max-width: 44ch;
    font-size: var(--fs-small);
    line-height: 1.5;
    /* Text color: on phones this line can pass over the figure as the page scrolls. */
    color: var(--text);
  }

  /* Desktop: left of the figure, ending above the tower tops. */
  @media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
    .hero__figure {
      left: calc(var(--fig-x-d) * 100%);
      top: calc(var(--fig-y-d) * 100%);
      height: calc(var(--fig-h-d) * 100%);
    }
    .hero__text {
      top: auto;
      right: auto;
      bottom: calc((1 - var(--sky-top-d)) * 100% + var(--space-6));
      /* The left ~45%: the name at the spec's size reaches about 48% of the width, which still
         clears the figure's head (its widest part, the shoulders, sits lower). The width comes
         from the name's size, not the loaded font ("Auyang" in Unbounded is 4.84em wide), so
         the block and its scrim don't change size when the font arrives. */
      width: calc(min(var(--fs-name), 15.5vh) * 4.9);
      max-width: 52%;
    }
    /* The spec's scale, held down on short windows so the block clears the header. */
    .hero__name {
      font-size: min(var(--fs-name), 15.5vh);
    }
    .hero__line {
      margin-top: var(--space-4);
      max-width: 26ch;
    }
    .hero__small {
      margin-top: var(--space-3);
    }
  }

  /* The scroll cue: bottom right, over the dark water. */
  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--dim);
    text-shadow: var(--halo);
    transition: opacity 400ms var(--ease-out);
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 32px;
    overflow: hidden;
    background: rgb(var(--text-rgb) / 0.18);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--window);
    transform-origin: top;
    animation: cue 2.4s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  :global(html[data-motion='off']) .hero__cue-line::after {
    animation: none;
    transform: none;
    opacity: 0.6;
  }
  .hero__cue:global(.is-gone) {
    opacity: 0;
    pointer-events: none;
  }

  /*
    The intro: with html.js-intro the three lines start masked and wipe in left to right when
    the timeline adds .is-in (600 ms, power3.out). Safety net: if .is-in hasn't come 2.5 s after
    load, they reveal anyway. The insets reach past the box so descenders are never clipped.
  */
  :global(html.js-intro) [data-intro] {
    clip-path: inset(-0.3em 100% -0.3em -0.3em);
    transition: clip-path var(--dur-reveal) var(--ease-out);
    animation: intro-safety var(--dur-reveal) var(--ease-out) 2.5s forwards;
  }
  :global(html.js-intro) [data-intro]:global(.is-in) {
    clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
  }
  @keyframes intro-safety {
    to {
      clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
    }
  }
</style>

<script>
  // The timeline hides the cue on the first scroll; this covers a page where it didn't load.
  const cue = document.querySelector('[data-scroll-cue]');
  if (cue) window.addEventListener('scroll', () => cue.classList.add('is-gone'), { once: true, passive: true });
</script>
