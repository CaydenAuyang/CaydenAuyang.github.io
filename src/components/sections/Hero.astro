---
// Hero.astro: the name, one line, one small line, and the scroll cue, over the dark sky.
//
// The layout follows the world contract (src/world/contract.ts): the figure of light sits centered
// in the sky (FIGURE_ANCHOR), the city is a band along the bottom (HERO_FRAMING.skylineTop), and the
// text stands between them, its bottom 8px above the tower tops, so it never sits on the figure or
// the skyline. The phone layout is usePhoneLayout(): phones, plus portrait screens under 1024px
// wide (portrait tablets). Its CSS twin, used below and in base.css:
//   phone:    @media (max-width: 767px), (max-width: 1023px) and (orientation: portrait)
//   desktop:  @media (min-width: 1024px), (min-width: 768px) and (orientation: landscape)
// The name fills the content width (one line on desktop, CAYDEN / AUYANG on phones), held down by
// height on short screens. The anchors arrive as CSS custom properties; a soft scrim sits behind
// the text.
//
// Timeline hooks: data-intro="name|line|small" (masked under html.js-intro until the timeline
// adds .is-in; revealed after 2.5 s regardless), data-scroll-cue (the timeline adds .is-gone on
// the first scroll). The figure's description is a role="img" box at the figure's place, shown
// to assistive tech only once the world (or its still) is drawn.
import { FIGURE_ANCHOR, HERO_FRAMING, PHONE_MAX_WIDTH, usePhoneLayout } from '../../world/contract';
import { hero, meta, titleColors } from '../../data/content';

// The CSS mirrors usePhoneLayout() with media queries. If the contract's rule moves, stop the
// build so the queries get updated with it.
const layoutCases: [number, number, boolean][] = [
  [390, 844, true],
  [767, 500, true],
  [768, 1024, true],
  [1023, 1366, true],
  [1023, 700, false],
  [768, 600, false],
  [1024, 1366, false],
  [1440, 900, false],
];
if (PHONE_MAX_WIDTH !== 767 || layoutCases.some(([w, h, phone]) => usePhoneLayout(w, h) !== phone)) {
  throw new Error('Hero.astro: usePhoneLayout() in contract.ts changed; update the phone/desktop media queries in the Pages CSS.');
}

const d = FIGURE_ANCHOR.desktop;
const p = FIGURE_ANCHOR.phone;
const vars = [
  `--fig-x-d: ${d.x}`,
  `--fig-y-d: ${d.y}`,
  `--fig-h-d: ${d.height}`,
  `--fig-x-p: ${p.x}`,
  `--fig-y-p: ${p.y}`,
  `--fig-h-p: ${p.height}`,
  `--sky-top-d: ${HERO_FRAMING.desktop.skylineTop}`,
  `--sky-top-p: ${HERO_FRAMING.phone.skylineTop}`,
].join('; ');
---

<section id="hero" class="hero" data-scene="hero" aria-labelledby="hero-name" style={vars}>
  <div class="hero__figure" role="img" aria-label={meta.figureAlt}></div>

  <div class="hero__text scrim scrim--soft">
    <h1 id="hero-name" class="hero__name t-display" data-intro="name">
      {
        hero.nameLines.map((line, i) => (
          <>
            {i > 0 && ' '}
            <span class:list={['hero__name-line', 'tw', `tw--${titleColors[hero.name][i]}`]}>{line}</span>
          </>
        ))
      }
    </h1>
    <p class="hero__line" data-intro="line">{hero.line.text}</p>
    <p class="hero__small t-meta" data-intro="small">{hero.small.text}</p>
  </div>

  <!-- The one-time hint for the city's pulse (src/scripts/hero-hint.ts). Hidden until the world is
       ready and its interactions are listening; never in snapshot or without WebGL. -->
  <p class="hero__hint t-meta" data-hero-hint data-snapshot-hide aria-hidden="true" hidden>
    <span class="hero__hint-ring"></span><span data-hint-text></span>
  </p>

  <div class="hero__cue" data-scroll-cue data-snapshot-hide aria-hidden="true">
    <span class="hero__cue-word t-label">{hero.scrollCue}</span>
    <span class="hero__cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
  }

  /* Where the figure of light is drawn: a box for its description, invisible. */
  .hero__figure {
    position: absolute;
    left: calc(var(--fig-x-p) * 100%);
    top: calc(var(--fig-y-p) * 100%);
    height: calc(var(--fig-h-p) * 100%);
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: none;
  }
  :global(html.is-ready) .hero__figure,
  :global(html:has([data-world-fallback][data-still])) .hero__figure {
    display: block;
  }

  /*
    The text stack (NIGHT-SIGNAL.md 3 and 7, v3.1): the figure sits centered in the sky above it
    (FIGURE_ANCHOR), the city is a band along the bottom (HERO_FRAMING), and the name, the line and
    the small line stand between them, the stack's bottom 8px above the tower tops. The name fills
    the content width: on one line in the desktop layout, on two lines (CAYDEN / AUYANG, each line
    filling the width) in the phone layout. Its size is fitted with the words' measured widths in
    Barlow Condensed 800 ("Cayden Auyang" 6.07em, "Cayden" 2.89em, "Auyang" 2.97em), so it doesn't
    depend on the loaded font, and held down by height on short screens so the whole stack fits
    between the figure (plus 16px) and the tower tops (minus 8px).
  */
  .hero__text {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc((1 - var(--sky-top-p)) * 100% + var(--space-2));
    /* The content width. */
    --w: calc(100vw - 2 * var(--gutter));
    /* Phone layout: the stack is two name lines (1.8em) plus about 141px (a 3-line line, a 2-line
       small line and their gaps); it must fit in (skylineTop - figure bottom) of the height, less
       24px: the name's size is at most (0.48 x height - 165px) / 1.8. */
    --name-cap: calc((var(--sky-top-p) - var(--fig-y-p) - var(--fig-h-p) / 2) * 100svh / 1.8 - 92px);
  }
  .hero__name {
    white-space: nowrap;
  }
  .hero__name-line {
    display: block;
  }
  .hero__name-line:first-child {
    font-size: min(var(--w) / 2.9, var(--name-cap));
  }
  .hero__name-line:last-child {
    font-size: min(var(--w) / 2.975, var(--name-cap));
  }
  .hero__line {
    margin-top: var(--space-3);
    max-width: 34ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: pretty;
  }
  .hero__small {
    margin-top: var(--space-2);
    max-width: 60ch;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--c-meta);
    text-wrap: balance;
  }

  /*
    Phones: a band of night at 60% under the whole stack (the spec's 60%, feathering out above and
    below, clear of the figure, running past the screen's sides where main clips it); the small
    line also carries the meta lines' halo and hugging scrim (t-meta).
    Short phones (700px tall or less): no scroll cue (it would sit beside the small line; it goes on
    the first scroll anyway).
  */
  @media (max-width: 767px), (max-width: 1023px) and (orientation: portrait) {
    .hero__text.scrim--soft::before {
      inset: calc(var(--space-3) * -1) -48px calc(var(--space-2) * -1);
      background: linear-gradient(
        to bottom,
        rgb(var(--night-rgb) / 0) 0,
        rgb(var(--night-rgb) / 0.6) var(--space-3),
        rgb(var(--night-rgb) / 0.6) calc(100% - var(--space-2)),
        rgb(var(--night-rgb) / 0) 100%
      );
    }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    .hero__cue {
      display: none;
    }
  }

  /* Desktop layout: the same stack, the name on one line, within the page's 1440px content width. */
  @media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
    .hero__figure {
      left: calc(var(--fig-x-d) * 100%);
      top: calc(var(--fig-y-d) * 100%);
      height: calc(var(--fig-h-d) * 100%);
    }
    .hero__text {
      left: max(var(--gutter), (100% - 1440px) / 2 + var(--gutter));
      right: max(var(--gutter), (100% - 1440px) / 2 + var(--gutter));
      bottom: calc((1 - var(--sky-top-d)) * 100% + var(--space-2));
      --w: calc(min(100vw, 1440px) - 2 * var(--gutter));
      /* From the name's cap tops (0.15em under its 0.9em line box) the stack is 0.75em plus about
         74px (the line on one line, the small line, their gaps). It must fit between the figure's
         box, plus 16px, and the tower tops, minus 8px. */
      --name-cap: calc(((var(--sky-top-d) - var(--fig-y-d) - var(--fig-h-d) / 2) * 100vh - 98px) / 0.75);
    }
    /* One line. The first word's box is its Barlow width (2.893em) and the gap the space's
       (0.21em), so "Auyang" starts at the same place before and after the font arrives. */
    .hero__name {
      display: flex;
      gap: 0.21em;
      font-size: min(var(--w) / 6.1, var(--name-cap));
    }
    .hero__name-line {
      display: block;
    }
    .hero__name-line:first-child {
      flex: none;
      width: 2.893em;
    }
    .hero__name-line:first-child,
    .hero__name-line:last-child {
      font-size: inherit;
    }
    .hero__line {
      max-width: none;
    }
  }
  /* Landscape tablets under 1024px: the line wraps to two lines, 30px more to fit. */
  @media (min-width: 768px) and (max-width: 1023px) and (orientation: landscape) {
    .hero__text {
      --name-cap: calc(((var(--sky-top-d) - var(--fig-y-d) - var(--fig-h-d) / 2) * 100vh - 128px) / 0.75);
    }
  }

  /*
    The hint: bottom left, level with the scroll cue, in dim with the meta lines' halo and scrim
    (it sits over the harbour's reflections). A small ring stands for the pulse. It fades in once
    the world is ready (after the intro with motion on) and out after the first pulse.
  */
  .hero__hint {
    position: absolute;
    left: var(--gutter);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    opacity: 0;
    transition: opacity var(--dur-fade) var(--ease-out);
  }
  .hero__hint[hidden] {
    display: none;
  }
  .hero__hint:global(.is-in) {
    opacity: 1;
  }
  .hero__hint:global(.is-gone),
  .hero__hint:global(.is-in.is-scrolled) {
    opacity: 0;
    transition-duration: 400ms;
  }
  .hero__hint-ring {
    position: relative;
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgb(var(--window-rgb) / 0.7);
  }
  .hero__hint-ring::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid rgb(var(--window-rgb) / 0.7);
    animation: hint-ring 2.4s var(--ease-out) infinite;
  }
  @keyframes hint-ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  :global(html[data-motion='off']) .hero__hint-ring::after {
    animation: none;
    opacity: 0;
  }

  /* The scroll cue: bottom right, over the dark water. */
  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-shadow: var(--halo);
    transition: opacity 400ms var(--ease-out);
  }
  /* A fixed box sized in em of the font size, not the face, with the word starting at its left
     edge, so the word swapping fonts moves nothing ("Scroll" is 3.0em in Barlow Condensed). */
  .hero__cue-word {
    width: 3.2em;
    white-space: nowrap;
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 32px;
    overflow: hidden;
    background: rgb(var(--text-rgb) / 0.18);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--window);
    transform-origin: top;
    animation: cue 2.4s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  :global(html[data-motion='off']) .hero__cue-line::after {
    animation: none;
    transform: none;
    opacity: 0.6;
  }
  .hero__cue:global(.is-gone) {
    opacity: 0;
    pointer-events: none;
  }

  /*
    The intro: with html.js-intro the three lines start masked and wipe in left to right when
    the timeline adds .is-in (600 ms, power3.out). Safety net: if .is-in hasn't come 2.5 s after
    load, they reveal anyway. The insets reach past the box so descenders are never clipped.
  */
  :global(html.js-intro) [data-intro] {
    clip-path: inset(-0.3em 100% -0.3em -0.3em);
    transition: clip-path var(--dur-reveal) var(--ease-out);
    animation: intro-safety var(--dur-reveal) var(--ease-out) 2.5s forwards;
  }
  :global(html.js-intro) [data-intro]:global(.is-in) {
    clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
  }
  @keyframes intro-safety {
    to {
      clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
    }
  }
</style>

<script>
  import '../../scripts/hero-hint';
  // The timeline hides the cue on the first scroll; this covers a page where it didn't load.
  const cue = document.querySelector('[data-scroll-cue]');
  if (cue) window.addEventListener('scroll', () => cue.classList.add('is-gone'), { once: true, passive: true });
</script>
