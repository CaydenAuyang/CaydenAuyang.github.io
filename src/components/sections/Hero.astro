---
// Hero.astro: the name, one line, one small line, and the scroll cue, over the dark sky.
//
// The layout follows the world contract (src/world/contract.ts): the figure of light sits in the
// sky (FIGURE_ANCHOR: the right half in short and wide, the top in stack) and the city is a band
// along the bottom (HERO_FRAMING.skylineTop). Side by side (short and wide) the text is a column
// on the left, its bottom 48px above the tower tops, its right edge 40px short of
// the figure; in stack it stands under the figure, its bottom 8px above the tower tops. So it
// never sits on the figure or the skyline. The layouts are V4.md 8.1's, defined once: the
// @media names in src/styles/media.css for the CSS, and layoutFor() in src/world/layout.ts for
// scripts (contract.ts's usePhoneLayout() is layoutFor() === 'stack').
// The name is at its spec size (V4.md section 4: --fs-name; in short it also scales with the
// height, tokens.css) unless its column or the height is smaller, in which case they win
// (CAYDEN / AUYANG, or one line where that fits). The whole hero is one small viewport tall
// (100svh), so the toolbar never moves it. The anchors arrive as CSS custom properties; a soft
// scrim sits behind the text.
//
// Timeline hooks: data-intro="name|line|small" (masked under html.js-intro until the timeline
// adds .is-in; revealed after 2.5 s regardless), data-scroll-cue (the timeline adds .is-gone on
// the first scroll). The figure's description is a role="img" box at the figure's place, shown
// to assistive tech only once the world (or its still) is drawn.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { FIGURE_ANCHOR, HERO_FRAMING, usePhoneLayout } from '../../world/contract';
import { layoutFor, MOUSE, PIN, pinsFor, SHORT, STACK, TOUCH, WIDE, type LayoutMode } from '../../world/layout';
import { hero, meta, titleColors } from '../../data/content';

// The layouts are defined twice, once per language (media.css for CSS, layout.ts for scripts and
// html[data-layout]). Stop the build if the two ever say different things, or if layoutFor() stops
// matching V4.md 8.1's table.
const fail = (message: string): never => {
  throw new Error(`Hero.astro: ${message}`);
};
// 1. Every @custom-media in media.css is the same query as its layout.ts string (spaces aside).
const squash = (q: string) => q.replace(/\s+/g, '').toLowerCase();
const mediaCss = readFileSync(join(process.cwd(), 'src/styles/media.css'), 'utf8').replace(/\/\*[\s\S]*?\*\//g, '');
const cssQueries = new Map([...mediaCss.matchAll(/@custom-media\s+--([\w-]+)\s+([^;]+);/g)].map((m) => [m[1], m[2]]));
const tsQueries: Record<string, string> = { stack: STACK, short: SHORT, wide: WIDE, pin: PIN, mouse: MOUSE, touch: TOUCH };
for (const [name, ts] of Object.entries(tsQueries)) {
  const css = cssQueries.get(name);
  if (css === undefined) fail(`src/styles/media.css has no @custom-media --${name} (layout.ts has it).`);
  else if (squash(css) !== squash(ts)) fail(`--${name} differs:\n  media.css: ${css}\n  layout.ts: ${ts}\nChange both together.`);
}
for (const name of cssQueries.keys()) {
  if (!(name in tsQueries)) fail(`src/styles/media.css defines --${name}, which layout.ts doesn't have.`);
}
// 2. layoutFor() against V4.md 8.1 at the device check's 15 sizes (scripts/devices.mjs) and at
// every edge of the table: 767/768 wide, portrait 1199/1200 wide, landscape 560/561 tall, and
// square (portrait in CSS). pinsFor(): wide and at least 600 tall.
const layoutCases: [number, number, LayoutMode][] = [
  [360, 800, 'stack'],
  [375, 667, 'stack'],
  [393, 852, 'stack'],
  [430, 932, 'stack'],
  [852, 393, 'short'],
  [932, 430, 'short'],
  [744, 1133, 'stack'],
  [820, 1180, 'stack'],
  [1024, 1366, 'stack'],
  [1133, 744, 'wide'],
  [1180, 820, 'wide'],
  [1366, 1024, 'wide'],
  [1280, 800, 'wide'],
  [1440, 900, 'wide'],
  [1920, 1080, 'wide'],
  [360, 640, 'stack'],
  [767, 500, 'stack'],
  [767, 400, 'stack'],
  [768, 500, 'short'],
  [768, 1024, 'stack'],
  [1199, 1600, 'stack'],
  [1200, 1600, 'wide'],
  [1199, 1199, 'stack'],
  [1200, 1200, 'wide'],
  [1000, 560, 'short'],
  [1000, 561, 'wide'],
  [1600, 560, 'short'],
];
for (const [w, h, want] of layoutCases) {
  const got = layoutFor(w, h);
  if (got !== want) fail(`layoutFor(${w}, ${h}) is "${got}", but V4.md 8.1 says "${want}" (src/world/layout.ts).`);
  if (usePhoneLayout(w, h) !== (want === 'stack')) fail(`usePhoneLayout(${w}, ${h}) in contract.ts no longer means layoutFor() === 'stack'.`);
}
const pinCases: [number, number, boolean][] = [
  [1280, 800, true],
  [1000, 600, true],
  [1000, 599, false],
  [1000, 561, false],
  [1200, 1600, true],
  [852, 393, false],
  [1024, 1366, false],
];
for (const [w, h, want] of pinCases) {
  if (pinsFor(w, h) !== want) fail(`pinsFor(${w}, ${h}) is ${!want}, but pins are wide and at least 600 tall (V4.md 8.1).`);
}
// 3. The query strings themselves at every size above, read the way a browser reads them (a comma
// is "or"; widths, heights and orientation, square counting as portrait), so html[data-layout],
// which Base.astro sets from the strings, always says what layoutFor() says. Exactly one layout
// matches each size.
function matches(list: string, w: number, h: number): boolean {
  return list.split(',').some((query) =>
    query.split(/\band\b/).every((part) => {
      const m = /\(\s*(min|max)-(width|height)\s*:\s*(\d+)px\s*\)|\(\s*orientation\s*:\s*(portrait|landscape)\s*\)/.exec(part);
      if (!m) return fail(`can't read "${part.trim()}" in "${list}" (layout.ts).`);
      if (m[4]) return (m[4] === 'portrait') === h >= w;
      const v = m[2] === 'width' ? w : h;
      return m[1] === 'min' ? v >= Number(m[3]) : v <= Number(m[3]);
    }),
  );
}
for (const [w, h] of [...layoutCases, ...pinCases]) {
  const hits = (['stack', 'short', 'wide'] as const).filter((mode) => matches({ stack: STACK, short: SHORT, wide: WIDE }[mode], w, h));
  if (hits.length !== 1 || hits[0] !== layoutFor(w, h)) fail(`at ${w} x ${h} the queries match [${hits.join(', ')}] but layoutFor() says "${layoutFor(w, h)}".`);
  if (matches(PIN, w, h) !== pinsFor(w, h)) fail(`at ${w} x ${h} PIN and pinsFor() disagree.`);
}

const d = FIGURE_ANCHOR.desktop;
const p = FIGURE_ANCHOR.phone;
const vars = [
  `--fig-x-d: ${d.x}`,
  `--fig-y-d: ${d.y}`,
  `--fig-h-d: ${d.height}`,
  `--fig-x-p: ${p.x}`,
  `--fig-y-p: ${p.y}`,
  `--fig-h-p: ${p.height}`,
  `--sky-top-d: ${HERO_FRAMING.desktop.skylineTop}`,
  `--sky-top-p: ${HERO_FRAMING.phone.skylineTop}`,
].join('; ');
---

<section id="hero" class="hero" data-scene="hero" aria-labelledby="hero-name" style={vars}>
  <div class="hero__figure" role="img" aria-label={meta.figureAlt}></div>

  <div class="hero__text scrim scrim--soft">
    <h1 id="hero-name" class="hero__name t-display" data-intro="name">
      {
        hero.nameLines.map((line, i) => (
          <>
            {i > 0 && ' '}
            <span class:list={['hero__name-line', 'tw', `tw--${titleColors[hero.name][i]}`]}>{line}</span>
          </>
        ))
      }
    </h1>
    <p class="hero__line" data-intro="line">{hero.line.text}</p>
    <p class="hero__small t-meta" data-intro="small">{hero.small.text}</p>
  </div>

  <!-- The one-time hint for the city's pulse (src/scripts/hero-hint.ts). Hidden until the world is
       ready and its interactions are listening; never in snapshot or without WebGL. -->
  <p class="hero__hint t-meta" data-hero-hint data-snapshot-hide aria-hidden="true" hidden>
    <span class="hero__hint-ring"></span><span data-hint-text></span>
  </p>

  <div class="hero__cue" data-scroll-cue data-snapshot-hide aria-hidden="true">
    <span class="hero__cue-word t-label">{hero.scrollCue}</span>
    <span class="hero__cue-line"></span>
  </div>
</section>

<style>
  @import '../../styles/media.css';

  /* One small viewport tall (V4.md 8.3), so the toolbar hiding or showing never changes it. The
     world it sits over is the large viewport's height (the canvas, base.css), and its anchors are
     shares of that, so everything placed against the figure or the skyline measures from the top
     in --world-h (tokens.css --lvh). With the toolbar showing, the bottom of the world runs below
     the window; the text stays put, clear of both. */
  .hero {
    position: relative;
    height: calc(100 * var(--svh));
    --world-h: calc(100 * var(--lvh));
  }
  @media (--stack) {
    .hero {
      min-height: 520px;
    }
  }
  /* On paper the hero is the first page exactly: on a short page (A5 landscape) the 520px floor
     spilled onto an empty second page. */
  @media print {
    .hero {
      min-height: 0;
    }
  }

  /* Where the figure of light is drawn: a box for its description, invisible. */
  .hero__figure {
    position: absolute;
    left: calc(var(--fig-x-p) * 100%);
    top: calc(var(--fig-y-p) * var(--world-h));
    height: calc(var(--fig-h-p) * var(--world-h));
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: none;
  }
  :global(html.is-ready) .hero__figure,
  :global(html:has([data-world-fallback][data-still])) .hero__figure {
    display: block;
  }

  /*
    The text stack (NIGHT-SIGNAL.md 3 and 7, v3 item 12): the name, the line and the small line.
    Stack (the base rules here): under the figure, the stack's bottom 8px above the tower tops,
    the name on two lines (CAYDEN / AUYANG) at the spec size (64px on phones), never wider than
    the content width: the words' measured widths in Barlow Condensed 800 ("Cayden Auyang" 6.07em,
    "Cayden" 2.89em, "Auyang" 2.97em) set that, so it doesn't depend on the loaded font. It is held
    down by height on short screens so the whole stack fits between the figure (plus 16px) and
    the tower tops (minus 8px). The side-by-side column (short and wide) is further down.
  */
  .hero__text {
    position: absolute;
    left: var(--gutter-l);
    right: var(--gutter-r);
    bottom: calc(100% - var(--sky-top-p) * var(--world-h) + var(--space-2));
    /* The content width. */
    --w: calc(100vw - var(--gutter-l) - var(--gutter-r));
    /* Stack: the stack is two name lines (1.8em) plus about 141px (a 3-line line, a 2-line small
       line and their gaps); it must fit in (skylineTop - figure bottom) of the height, less 24px:
       the name's size is at most (0.48 x height - 165px) / 1.8. */
    --name-cap: calc((var(--sky-top-p) - var(--fig-y-p) - var(--fig-h-p) / 2) * var(--world-h) / 1.8 - 92px);
  }
  .hero__name {
    white-space: nowrap;
  }
  .hero__name-line {
    display: block;
    font-size: min(var(--fs-name), var(--w) / 2.975, var(--name-cap));
  }
  .hero__line {
    margin-top: var(--space-3);
    max-width: 34ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: pretty;
  }
  .hero__small {
    margin-top: var(--space-2);
    max-width: 60ch;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--c-meta);
    text-wrap: balance;
  }

  /*
    Stack: a band of night at 60% under the stack (the spec's 60%, feathering in above it, clear
    of the figure, running past the screen's sides where main clips it). Below, there is no room
    to feather out under the text (the tower tops are 8px down), so it eases out across the small
    line instead and is gone at the tower tops, leaving no edge across the horizon haze. The small
    line's own scrim (t-meta) makes up the rest under it, as a wider, softer ellipse than the
    usual hug, so it doesn't read as a second box. The small line keeps at least 5.8:1 with the
    searchlight behind it.
    Short phones (700px tall or less): no scroll cue (it would sit beside the small line; it goes on
    the first scroll anyway).
  */
  @media (--stack) {
    .hero__text.scrim--soft::before {
      inset: calc(var(--space-3) * -1) -48px calc(var(--space-2) * -1);
      background: linear-gradient(
        to bottom,
        rgb(var(--night-rgb) / 0) 0,
        rgb(var(--night-rgb) / 0.6) var(--space-3),
        rgb(var(--night-rgb) / 0.6) calc(100% - 56px),
        rgb(var(--night-rgb) / 0.5) calc(100% - 44px),
        rgb(var(--night-rgb) / 0.34) calc(100% - 30px),
        rgb(var(--night-rgb) / 0.17) calc(100% - 16px),
        rgb(var(--night-rgb) / 0.05) calc(100% - 6px),
        rgb(var(--night-rgb) / 0) 100%
      );
    }
    .hero__small.t-meta::before {
      inset: -18px -40px;
      background: radial-gradient(
        closest-side,
        rgb(var(--night-rgb) / 0.6) 0%,
        rgb(var(--night-rgb) / 0.55) 40%,
        rgb(var(--night-rgb) / 0.3) 70%,
        rgb(var(--night-rgb) / 0.1) 88%,
        rgb(var(--night-rgb) / 0) 100%
      );
    }
  }
  @media (--stack) {
    /* (.hero in front: the cue's own rule further down comes later and would win otherwise, as it
       did until v4, so the cue still showed on short phones.) */
    @media (max-height: 700px) {
      .hero .hero__cue {
        display: none;
      }
    }
    /* A stack window shorter than the hero's 520px floor (a narrow desktop window; phones held
       sideways are short, below): there is no room between the figure and the tower tops for the
       stack, and the height cap would shrink the name to nothing. So the stack starts 24px under
       the figure instead, the name keeps its spec size (64px), and the stack runs on over the
       skyline and a little below the first screen, over its band of night. */
    @media (max-height: 519px) {
      .hero__text {
        top: calc((var(--fig-y-p) + var(--fig-h-p) / 2) * var(--world-h) + var(--space-4));
        bottom: auto;
        --name-cap: var(--fs-name);
      }
    }
  }

  /*
    Side by side (short and wide): the stack in a column on the left, its bottom 48px above the
    tower tops as before v3, and the figure in the right half of the sky. The column runs from the
    gutter to 40px short of the figure's drawn left edge, which is 0.449 of the figure's height
    left of its anchor (the figure is about 0.92 times as wide as it is tall, and widest at rest:
    turning it only moves that edge right). The figure's place comes from the canvas (the window's
    width and the large viewport's height), so the column does too. In short (phones sideways) the
    hero is just the window's height, with the name scaled to it (tokens.css), and the whole stack
    fits between the header and the tower tops: at 852 x 393 the name is one line of 59px.
  */
  @media (--short), (--wide) {
    .hero__figure {
      left: calc(var(--fig-x-d) * 100%);
      top: calc(var(--fig-y-d) * var(--world-h));
      height: calc(var(--fig-h-d) * var(--world-h));
    }
    .hero__text {
      right: auto;
      bottom: calc(100% - var(--sky-top-d) * var(--world-h) + var(--space-6));
      width: var(--col);
      --col: calc(var(--fig-x-d) * 100vw - 0.449 * var(--fig-h-d) * var(--world-h) - 40px - var(--gutter-l));
      /* The height from the stack's bottom up to 16px under the header. */
      --room: calc(var(--sky-top-d) * var(--world-h) - var(--space-6) - var(--header-h) - var(--space-3));
      /* Under the name's cap tops (0.15em under its first 0.9em line box): the line (two lines of
         at most 34 characters, 20.4em of mono; three where the column is narrower), the small
         line (52 characters, 31.2em; two lines where the column is narrower) and their gaps. */
      --lead-lh: calc(var(--fs-lead) * var(--lh-lead));
      --small-lh: calc(var(--fs-small) * 1.5);
      --rest: calc(
        var(--space-4) + 2 * var(--lead-lh) + clamp(0px, (20.4 * var(--fs-lead) - var(--col)) * 1000, var(--lead-lh)) +
          var(--space-3) + var(--small-lh) + clamp(0px, (31.2 * var(--fs-small) - var(--col)) * 1000, var(--small-lh))
      );
    }
    /*
      The spec size (--fs-name), unless the column or the room is smaller: then the bigger of the
      two fits, two lines (CAYDEN / AUYANG, "Auyang" filling the column; the stack is 1.65em plus
      the rest) or one line (6.08em across; 0.75em plus the rest), each held down by the room. The
      words are flex items in boxes of their Barlow widths, with the space's width (0.21em)
      between, so they wrap to two lines exactly when one line doesn't fit, and the same way before
      and after the font arrives. (At 1024 to 1920 wide the column holds the spec size on two
      lines; the 40px floor is a guard that no real window reaches.)
    */
    .hero__name {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.21em;
      font-size: min(
        var(--fs-name),
        max(
          min(var(--col) / 2.968, (var(--room) - var(--rest)) / 1.65),
          min(var(--col) / 6.08, (var(--room) - var(--rest)) / 0.75),
          40px
        )
      );
    }
    .hero__name-line {
      display: block;
      flex: none;
      font-size: inherit;
    }
    .hero__name-line:first-child {
      width: 2.893em;
    }
    .hero__name-line:last-child {
      width: 2.968em;
    }
    /* Two lines, as on the spec's diagram: the second ("people, and build tools that help.") is
       34 characters. At exactly 34ch it fits with nothing to spare, and for one frame while the
       font swaps it wrapped to three lines (a layout shift); any width up to 37ch wraps the same. */
    .hero__line {
      margin-top: var(--space-4);
      max-width: 35ch;
    }
    .hero__small {
      margin-top: var(--space-3);
    }
  }

  /*
    The hint: bottom left, level with the scroll cue, in dim with the meta lines' halo and scrim
    (it sits over the harbour's reflections). A small ring stands for the pulse. It fades in once
    the world is ready (after the intro with motion on) and out after the first pulse.
  */
  .hero__hint {
    position: absolute;
    left: var(--gutter-l);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    opacity: 0;
    transition: opacity var(--dur-fade) var(--ease-out);
  }
  .hero__hint[hidden] {
    display: none;
  }
  .hero__hint:global(.is-in) {
    opacity: 1;
  }
  .hero__hint:global(.is-gone),
  .hero__hint:global(.is-in.is-scrolled) {
    opacity: 0;
    transition-duration: 400ms;
  }
  .hero__hint-ring {
    position: relative;
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgb(var(--window-rgb) / 0.7);
  }
  .hero__hint-ring::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid rgb(var(--window-rgb) / 0.7);
    animation: hint-ring 2.4s var(--ease-out) infinite;
  }
  @keyframes hint-ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  :global(html[data-motion='off']) .hero__hint-ring::after {
    animation: none;
    opacity: 0;
  }

  /* The scroll cue: bottom right, over the dark water. */
  .hero__cue {
    position: absolute;
    right: var(--gutter-r);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-shadow: var(--halo);
    transition: opacity 400ms var(--ease-out);
  }
  /* A fixed box sized in em of the font size, not the face, with the word starting at its left
     edge, so the word swapping fonts moves nothing ("Scroll" is 3.0em in Barlow Condensed). */
  .hero__cue-word {
    width: 3.2em;
    white-space: nowrap;
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 32px;
    overflow: hidden;
    background: rgb(var(--text-rgb) / 0.18);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--window);
    transform-origin: top;
    animation: cue 2.4s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  :global(html[data-motion='off']) .hero__cue-line::after {
    animation: none;
    transform: none;
    opacity: 0.6;
  }
  .hero__cue:global(.is-gone) {
    opacity: 0;
    pointer-events: none;
  }

  /*
    The intro: with html.js-intro the three lines start masked and wipe in left to right when
    the timeline adds .is-in (600 ms, power3.out). Safety net: if .is-in hasn't come 2.5 s after
    load, they reveal anyway. The insets reach past the box so descenders are never clipped.
  */
  :global(html.js-intro) [data-intro] {
    clip-path: inset(-0.3em 100% -0.3em -0.3em);
    transition: clip-path var(--dur-reveal) var(--ease-out);
    animation: intro-safety var(--dur-reveal) var(--ease-out) 2.5s forwards;
  }
  :global(html.js-intro) [data-intro]:global(.is-in) {
    clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
  }
  @keyframes intro-safety {
    to {
      clip-path: inset(-0.3em -0.3em -0.3em -0.3em);
    }
  }
</style>

<script>
  import '../../scripts/hero-hint';
  import '../../scripts/print-still';
  // The timeline hides the cue on the first scroll; this covers a page where it didn't load.
  const cue = document.querySelector('[data-scroll-cue]');
  if (cue) window.addEventListener('scroll', () => cue.classList.add('is-gone'), { once: true, passive: true });
</script>
