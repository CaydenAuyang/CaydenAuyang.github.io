---
// Locator.astro: the 24px nested-box locator on each Work plate.
// Outer box: a city. Middle box: an organization. Inner box: a school. The plate's own level is
// filled with the mark color. Decorative (aria-hidden): the scale tag's words beside it carry
// the meaning. The fill fades in once when the plate comes into view (M8, src/scripts/datum/work.ts).
interface Props {
  level: 'city' | 'org' | 'school';
}
const { level } = Astro.props;

// Each level's filled area: the ring between its box and the next one in (the school is solid).
const fills = {
  city: 'M0.5 0.5H23.5V23.5H0.5Z M4.5 4.5V19.5H19.5V4.5Z',
  org: 'M4.5 4.5H19.5V19.5H4.5Z M8.5 8.5V15.5H15.5V8.5Z',
  school: 'M8.5 8.5H15.5V15.5H8.5Z',
};
---

<svg class="locator" data-locator data-level={level} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <path class="locator__fill" d={fills[level]} fill-rule="evenodd" />
  <rect class:list={['locator__box', level === 'city' && 'is-active']} x="0.5" y="0.5" width="23" height="23" />
  <rect class:list={['locator__box', level === 'org' && 'is-active']} x="4.5" y="4.5" width="15" height="15" />
  <rect class:list={['locator__box', level === 'school' && 'is-active']} x="8.5" y="8.5" width="7" height="7" />
</svg>

<style>
  .locator {
    flex: none;
    width: 24px;
    height: 24px;
    overflow: visible;
  }
  .locator__fill {
    fill: var(--mark);
  }
  .locator__box {
    fill: none;
    stroke: var(--neatline);
    stroke-width: 1;
  }
  .locator__box.is-active {
    stroke: var(--text);
  }
  /* M8: the fill fades in once, on view. Hidden only while motion is allowed and the script
     hasn't reached it yet. */
  :global(html.js-motion) .locator:not(.is-on) .locator__fill {
    opacity: 0;
  }
  .locator__fill {
    transition: opacity var(--dur-locator) var(--ease-quick);
  }
</style>
