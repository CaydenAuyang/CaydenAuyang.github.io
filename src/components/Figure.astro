---
// Figure.astro: the point figure of Cayden for the hero.
//
// Renders a canvas (drawn by src/figure/index.js with WebGL) and a still image of the same figure
// for when WebGL is missing or fails, or JavaScript is off. The component fills its parent box;
// the parent decides the frame's size and shape (the hero uses a 4:5 frame).
//
// The renderer starts only after the first paint, when the browser is idle, and downloads the
// point data then (about 190 KB on phones, 580 KB on laptops).
//
// Accessibility: the canvas is aria-hidden. When the canvas is showing, a visually hidden text
// describes the figure; when the image is showing, its alt text does. Inside a parent that
// already carries role="img" and an aria-label (like the hero's frame), pass `decorative` so the
// figure is not described twice.
//
// Colors: set --figure-point and --figure-glow (any CSS color) on this element or an ancestor.
// Optional --figure-blend: add for dark pages. After changing them at runtime, dispatch a
// "figure:theme" event on document.

interface Props {
  alt?: string;
  class?: string;
  decorative?: boolean;
  srcHi?: string;
  srcLo?: string;
  fallback?: string;
  width?: number;
  height?: number;
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const {
  alt = 'A portrait of Cayden Auyang drawn in points',
  class: className,
  decorative = false,
  srcHi = `${base}figure/figure-hi.bin`,
  srcLo = `${base}figure/figure-lo.bin`,
  fallback = `${base}figure/figure-fallback.webp`,
  width = 720,
  height = 900,
} = Astro.props;
---

<div class:list={['figure', className]} data-figure-mount data-state="idle" data-src-hi={srcHi} data-src-lo={srcLo}>
  <canvas class="figure__canvas" aria-hidden="true"></canvas>
  <img class="figure__fallback" src={fallback} alt={decorative ? '' : alt} width={width} height={height} loading="lazy" decoding="async" />
  {!decorative && <span class="figure__desc">{alt}</span>}
</div>

<script>
  type Mounted = HTMLElement & { __figure?: unknown };

  function showFallback(root: HTMLElement) {
    root.setAttribute('data-state', 'fallback');
    const img = root.querySelector<HTMLImageElement>('.figure__fallback');
    if (img) img.loading = 'eager';
  }

  function start() {
    const roots = Array.from(document.querySelectorAll<Mounted>('[data-figure-mount]')).filter((r) => !r.__figure);
    if (!roots.length) return;
    import('../figure/index.js')
      .then(({ mountFigure }) => {
        for (const root of roots) {
          const canvas = root.querySelector('canvas');
          if (!canvas) continue;
          try {
            root.__figure = mountFigure(canvas, {
              srcHi: root.dataset.srcHi,
              srcLo: root.dataset.srcLo,
              fallbackImg: root.querySelector('.figure__fallback'),
              descEl: root.querySelector('.figure__desc'),
              wrapper: root,
            });
          } catch {
            showFallback(root);
          }
        }
      })
      .catch(() => roots.forEach(showFallback));
  }

  // After the first paint, when the browser is idle (at most about 1.2 seconds later).
  function afterFirstPaint(fn: () => void) {
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(fn, { timeout: 1200 });
        else setTimeout(fn, 200);
      }),
    );
  }

  afterFirstPaint(start);
</script>

<style>
  .figure {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .figure__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .figure__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    display: none;
  }
  .figure[data-state='fallback'] .figure__fallback {
    display: block;
  }
  .figure[data-state='fallback'] .figure__canvas {
    display: none;
  }
  .figure__desc {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .figure[data-state='fallback'] .figure__desc {
    display: none;
  }
  /* JavaScript off: the still image is the figure. */
  @media (scripting: none) {
    .figure__fallback {
      display: block;
    }
    .figure__canvas,
    .figure__desc {
      display: none;
    }
  }
</style>
