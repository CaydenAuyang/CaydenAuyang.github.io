---
// Figure.astro: the point figure of Cayden for the hero plate (Datum design).
//
// Renders a canvas (drawn by src/figure/index.js with WebGL) and a still image of the same figure
// for when WebGL is missing, the context is lost, the data is late, or JavaScript is off. The
// component fills its parent box; the hero's plate decides the size (9:10 on phones, 4:5 on
// laptops). The renderer starts after the first paint, when the browser is idle, and only then
// downloads the point data (about 180 KB on phones, 600 KB on laptops).
//
// Accessibility: by default (decorative) the canvas and the image are aria-hidden and the image
// has alt="", because the hero's [data-figure] container carries role="img" and the alt text.
// For standalone use (the lab page), pass alt: the image gets it and a visually hidden text
// describes the canvas.
//
// Colors and size come from the tokens: --figure-point, --figure-origin-b, --figure-alpha-floor,
// --figure-point-scale (snapshot mode changes them). Motion follows src/components/ui/motion.ts.
//
// Events: "figure:ready" (bubbles) with detail.count when drawn; send "figure:replay" to the
// element with data-figure-mount to rerun the assembly.

interface Props {
  alt?: string;
  decorative?: boolean;
  class?: string;
  srcHi?: string;
  srcLo?: string;
  srcMeta?: string;
  fallback?: string;
  width?: number;
  height?: number;
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const {
  alt,
  decorative = !alt,
  class: className,
  srcHi = `${base}figure/figure-hi.bin`,
  srcLo = `${base}figure/figure-lo.bin`,
  srcMeta = `${base}figure/figure.json`,
  fallback = `${base}figure/figure-fallback.webp`,
  width = 720,
  height = 900,
} = Astro.props;
const described = !decorative && !!alt;
---

<div
  class:list={['figure', className]}
  data-figure-mount
  data-state="idle"
  data-src-hi={srcHi}
  data-src-lo={srcLo}
  data-src-meta={srcMeta}
>
  <canvas class="figure__canvas" aria-hidden="true"></canvas>
  <img
    class="figure__fallback"
    src={fallback}
    alt={described ? alt : ''}
    aria-hidden={described ? undefined : 'true'}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  {described && <span class="figure__desc">{alt}</span>}
</div>

<script>
  import { motionAllowed, isSnapshot, onMotionChange } from './ui/motion';

  type Mounted = HTMLElement & { __figure?: unknown };

  function showFallback(root: HTMLElement) {
    root.setAttribute('data-fallback-shown', '');
    const img = root.querySelector<HTMLImageElement>('.figure__fallback');
    if (img) img.loading = 'eager';
    requestAnimationFrame(() => requestAnimationFrame(() => root.setAttribute('data-state', 'fallback')));
  }

  function start() {
    const roots = Array.from(document.querySelectorAll<Mounted>('[data-figure-mount]')).filter((r) => !r.__figure);
    if (!roots.length) return;
    import('../figure/index.js')
      .then(({ mountFigure }) => {
        for (const root of roots) {
          const canvas = root.querySelector('canvas');
          if (!canvas) continue;
          try {
            root.__figure = mountFigure(canvas, {
              srcHi: root.dataset.srcHi,
              srcLo: root.dataset.srcLo,
              srcMeta: root.dataset.srcMeta,
              fallbackImg: root.querySelector('.figure__fallback'),
              descEl: root.querySelector('.figure__desc'),
              wrapper: root,
              motionAllowed,
              isSnapshot,
              onMotionChange,
            });
          } catch {
            showFallback(root);
          }
        }
      })
      .catch(() => roots.forEach(showFallback));
  }

  // After the first paint, when the browser is idle (at most about 1.2 seconds later).
  requestAnimationFrame(() =>
    requestAnimationFrame(() => {
      if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 1200 });
      else setTimeout(start, 200);
    }),
  );
</script>

<style>
  .figure {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .figure__canvas,
  .figure__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-fade, 240ms) var(--ease-quick, cubic-bezier(0.2, 0, 0, 1));
  }
  .figure__canvas {
    display: block;
  }
  /* The still image stays out of layout (and is not downloaded) until it is needed. Then it is
     laid out at opacity 0 and cross-fades in (M4); the canvas fades out. */
  .figure__fallback {
    display: none;
    opacity: 0;
    object-fit: cover;
    object-position: 50% 0%;
  }
  .figure[data-fallback-shown] .figure__fallback {
    display: block;
  }
  .figure[data-state='fallback'] .figure__fallback {
    opacity: 1;
  }
  .figure[data-state='fallback'] .figure__canvas {
    opacity: 0;
  }
  .figure__desc {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .figure[data-state='fallback'] .figure__desc {
    display: none;
  }
  /* JavaScript off: the still image is the figure. */
  @media (scripting: none) {
    .figure__fallback {
      display: block;
      opacity: 1;
    }
    .figure__canvas,
    .figure__desc {
      display: none;
    }
  }
</style>
