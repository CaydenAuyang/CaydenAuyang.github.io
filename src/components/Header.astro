---
// Header.astro: the only thing fixed on screen. The name, small, at top left (back to the top),
// and "Menu" at top right.
//
// Menu opens a full-screen overlay listing the section links over the dimmed world. It is a
// modal <dialog>: the rest of the page is inert while it is open (a focus trap), Esc closes it,
// and focus goes back to the Menu button. Picking a section closes it and moves focus to that
// section. While it is open the page can't scroll (V4.md 8.2): `overflow: hidden` on <html>, and
// `world:scroll-lock` so the timeline stops and starts smooth scrolling; closing it puts the page
// back where it was (src/scripts/menu.ts). Every control is a 44px target.
//
// Without JavaScript the Menu button is hidden; every section is still a scroll away.
// In snapshot mode the Menu button is hidden too.
import { nav } from '../data/content';
import { site, ui } from '../data/site';

interface Props {
  menu?: boolean;
}
const { menu = false } = Astro.props;
---

<header class="site-header">
  <a class="site-header__name" href={menu ? '#main' : '/'} data-home>{site.name}</a>
  {
    menu && (
      <button
        type="button"
        class="site-header__btn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
        data-needs-js
        data-snapshot-hide
      >
        {ui.menu}
      </button>
    )
  }
</header>

{
  menu && (
    <dialog id="menu" class="menu" aria-label={ui.menuLabel} data-menu>
      <div class="menu__bar">
        <span class="site-header__name menu__name" aria-hidden="true">
          {site.name}
        </span>
        <button type="button" class="site-header__btn" data-menu-close>
          {ui.close}
        </button>
      </div>
      <nav class="menu__nav" aria-label={ui.menuLabel}>
        <ol class="menu__list">
          {nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a class="menu__link" href={item.href} data-menu-link>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </dialog>
  )
}

<script>
  import '../scripts/menu';
  import '../scripts/header';
</script>

<style>
  @import '../styles/media.css';

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: var(--header-h);
    padding-left: var(--gutter-l);
    padding-right: var(--gutter-r);
    padding-top: env(safe-area-inset-top, 0);
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }
  /* Text scrolls right under the name and Menu, so the header's own 64px are solid night
     (nothing runs into its words or ghosts through beside them), then the backing fades out over
     the next 48px. At the very top of the page it is clear, so it never dims the figure's crown;
     it fades in over the first scroll (src/scripts/header.ts adds .is-scrolled after 16px, long
     before any hero text could reach the header). Without JavaScript it simply stays on. With
     reduced motion it switches without a transition (base.css). The name and Menu keep their own
     text-shadow, so they read over the sky. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 calc(var(--space-6) * -1) 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(var(--night-rgb) / 1) 0%,
      rgb(var(--night-rgb) / 1) 57%,
      rgb(var(--night-rgb) / 0.5) 78%,
      rgb(var(--night-rgb) / 0) 100%
    );
    pointer-events: none;
    transition: opacity 300ms var(--ease-out);
  }
  :global(html.js) .site-header:not(:global(.is-scrolled))::before {
    opacity: 0;
  }

  .site-header__name,
  .site-header__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 15px;
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--text);
    text-decoration: none;
    text-shadow: 0 0 12px rgb(var(--night-rgb) / 0.9);
  }
  /* The name, in the name's face: Barlow Condensed 800, uppercase. */
  .site-header__name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: var(--fw-name);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }
  .site-header__btn {
    min-width: var(--tap);
    justify-content: center;
    padding-inline: var(--space-3);
    margin-right: calc(var(--space-3) * -1);
    border-radius: var(--radius-control);
    transition: color var(--dur-quick) var(--ease-out);
  }
  /* Hover looks only with a mouse: on touch a tapped control would keep them (V4.md 8.4). */
  @media (--mouse) {
    .site-header__name:hover,
    .site-header__btn:hover {
      color: var(--window);
    }
  }
  /* Menu and Close sit flush with the screen's right edge on phones, so their ring is drawn
     inside the button, where the edge can't clip it. */
  .site-header__btn:focus-visible {
    outline-offset: -2px;
    box-shadow: inset 0 0 0 6px var(--focus-halo);
  }

  /* The overlay: the whole screen, the world dimmed behind it. No glass here. It scrolls on its
     own if it has to (a phone held sideways), and a swipe that reaches its end never carries on
     to the locked page behind. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter-r) calc(var(--space-6) + env(safe-area-inset-bottom, 0px)) var(--gutter-l);
    border: 0;
    background: rgb(var(--night-rgb) / 0.86);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-in 240ms var(--ease-out);
  }
  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-top: env(safe-area-inset-top, 0);
    flex: none;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--space-5);
  }
  .menu__list {
    display: grid;
    gap: var(--space-1);
  }
  /* Menu items are JetBrains Mono, like every control (spec section 3). */
  .menu__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 1.6vw + 18px, 44px);
    line-height: 1.2;
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur-quick) var(--ease-out);
  }
  @media (--mouse) {
    .menu__link:hover {
      color: var(--window);
    }
  }
  .menu[open] .menu__list > li {
    animation: menu-item 420ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--i) * 40ms);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  :global(html[data-motion='off']) .menu[open],
  :global(html[data-motion='off']) .menu[open] .menu__list > li {
    animation: none;
  }
</style>
