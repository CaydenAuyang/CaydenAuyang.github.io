---
// Header.astro: the only thing fixed on screen. The name, small, at top left (back to the top),
// and "Menu" at top right.
//
// Menu opens a full-screen overlay listing the section links over the dimmed world. It is a
// modal <dialog>: the rest of the page is inert while it is open (a focus trap), Esc closes it,
// and focus goes back to the Menu button. Picking a section closes it and moves focus to that
// section. Opening and closing dispatch `world:scroll-lock` so the timeline can stop and start
// smooth scrolling (src/scripts/menu.ts).
//
// Without JavaScript the Menu button is hidden; every section is still a scroll away.
// In snapshot mode the Menu button is hidden too.
import { nav } from '../data/content';
import { site, ui } from '../data/site';

interface Props {
  menu?: boolean;
}
const { menu = false } = Astro.props;
---

<header class="site-header">
  <a class="site-header__name" href={menu ? '#main' : '/'} data-home>{site.name}</a>
  {
    menu && (
      <button
        type="button"
        class="site-header__btn"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
        data-needs-js
        data-snapshot-hide
      >
        {ui.menu}
      </button>
    )
  }
</header>

{
  menu && (
    <dialog id="menu" class="menu" aria-label={ui.menuLabel} data-menu>
      <div class="menu__bar">
        <span class="site-header__name menu__name" aria-hidden="true">
          {site.name}
        </span>
        <button type="button" class="site-header__btn" data-menu-close>
          {ui.close}
        </button>
      </div>
      <nav class="menu__nav" aria-label={ui.menuLabel}>
        <ol class="menu__list">
          {nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a class="menu__link" href={item.href} data-menu-link>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </dialog>
  )
}

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: var(--header-h);
    padding-inline: var(--gutter);
    padding-top: env(safe-area-inset-top, 0);
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }
  /* A soft scrim so text scrolling under the header stays legible. A fade, never a bar. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 calc(var(--space-6) * -1) 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(var(--night-rgb) / 0.82) 0%,
      rgb(var(--night-rgb) / 0.55) 50%,
      rgb(var(--night-rgb) / 0) 100%
    );
    pointer-events: none;
  }

  .site-header__name,
  .site-header__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 15px;
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--text);
    text-decoration: none;
    text-shadow: 0 0 12px rgb(var(--night-rgb) / 0.9);
  }
  .site-header__btn {
    min-width: var(--tap);
    justify-content: center;
    padding-inline: var(--space-3);
    margin-right: calc(var(--space-3) * -1);
    border-radius: var(--radius-control);
    transition: color var(--dur-quick) var(--ease-out);
  }
  .site-header__name:hover,
  .site-header__btn:hover {
    color: var(--window);
  }

  /* The overlay: the whole screen, the world dimmed behind it. No glass here. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) var(--space-6);
    border: 0;
    background: rgb(var(--night-rgb) / 0.86);
    color: var(--text);
    overflow-y: auto;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-in 240ms var(--ease-out);
  }
  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-top: env(safe-area-inset-top, 0);
    flex: none;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--space-5);
  }
  .menu__list {
    display: grid;
    gap: var(--space-1);
  }
  .menu__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(28px, 3.2vw + 12px, 56px);
    line-height: 1.1;
    letter-spacing: var(--track-display);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur-quick) var(--ease-out);
  }
  .menu__link:hover {
    color: var(--window);
  }
  .menu[open] .menu__list > li {
    animation: menu-item 420ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--i) * 40ms);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  :global(html[data-motion='off']) .menu[open],
  :global(html[data-motion='off']) .menu[open] .menu__list > li {
    animation: none;
  }
</style>
