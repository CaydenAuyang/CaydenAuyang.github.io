---
// LoopVideo.astro: a short, muted project preview in a glass frame.
//
// The frame: 16:10, a 14px radius, a glass border (1px window at 18%) and a soft outer glow in
// window at 8%. The 16:10 box is reserved before anything loads, so nothing shifts. The caption
// sits below it.
//
// How it behaves (src/scripts/loop-video.ts):
//   - muted, playsinline, loop, no autoplay attribute. preload="none" until the video is within
//     one viewport of the screen; then it may start loading.
//   - Plays while at least half of it is visible, pauses otherwise.
//   - A visible 44px Pause / Play button, labelled with the project's name. A pause the visitor
//     makes sticks until they press Play.
//   - Reduced motion: the poster and a Play button; it plays only if asked.
//   - Snapshot mode: the poster only, no button.
//   - If the browser refuses to play (Low Power Mode, data saver) the poster stays and the button
//     says Play. Without JavaScript: the poster only.
import { ui } from '../../data/site';
import type { Clip } from './previews';

interface Props {
  // Used in the button's label: "Pause OurCityHealth preview".
  name: string;
  caption: string;
  src?: Clip;
  class?: string;
}

const { name, caption, src, class: className } = Astro.props;
const label = ui.previewOf(name);
const width = src?.width ?? 1280;
const height = src?.height ?? 800;
---

<figure class:list={['vf', className]} data-vf={src ? '' : undefined} data-state="paused">
  <div class="vf__frame">
    <div class="vf__media">
      {
        src ? (
          <>
            <video
              class="vf__video"
              muted
              playsinline
              loop
              preload="none"
              poster={src.poster}
              width={width}
              height={height}
              aria-label={label}
              disablepictureinpicture
              disableremoteplayback
            >
              {src.webm && <source src={src.webm} type="video/webm" />}
              <source src={src.mp4} type="video/mp4" />
            </video>
            <button
              type="button"
              class="vf__btn"
              data-vf-btn
              data-needs-js
              data-snapshot-hide
              data-label={label}
              aria-label={`${ui.play} ${label}`}
            >
              <svg class="vf__icon vf__icon--play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M4.5 2.75v10.5l8.5-5.25z" fill="currentColor" />
              </svg>
              <svg class="vf__icon vf__icon--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M4 2.75h2.75v10.5H4zM9.25 2.75H12v10.5H9.25z" fill="currentColor" />
              </svg>
            </button>
          </>
        ) : (
          <p class="vf__empty">{ui.previewPending}</p>
        )
      }
    </div>
  </div>
  <figcaption class="vf__cap">{caption}</figcaption>
</figure>

<script>
  import '../../scripts/loop-video';
</script>

<style>
  .vf {
    position: relative;
    z-index: 1; /* above neighbouring text scrims */
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .vf__frame {
    padding: 6px;
    border-radius: var(--radius-frame);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--glow-soft);
  }

  .vf__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-frame) - 6px);
    background: var(--night);
  }
  .vf__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vf__btn {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    background: rgb(var(--night-rgb) / 0.72);
    color: var(--text);
    box-shadow:
      0 0 0 1px rgb(var(--text-rgb) / 0.22),
      0 4px 16px rgb(var(--night-rgb) / 0.4);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition:
      background var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out);
  }
  .vf__btn:hover {
    background: rgb(var(--night-rgb) / 0.9);
    color: var(--window);
  }
  .vf__btn:focus-visible {
    border-radius: 50%;
  }
  .vf[data-state='playing'] .vf__icon--play,
  .vf:not([data-state='playing']) .vf__icon--pause {
    display: none;
  }

  .vf__empty {
    position: absolute;
    inset: var(--space-3);
    display: grid;
    place-items: center;
    border: 1px dashed var(--glass-border);
    border-radius: 6px;
    color: var(--dim);
    font-size: var(--fs-small);
    text-align: center;
  }

  .vf__cap {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--dim);
    text-shadow: var(--halo);
  }
</style>
