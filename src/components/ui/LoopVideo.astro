---
// LoopVideo.astro: a short, muted project preview in a glass frame.
//
// The frame: 16:10, a 14px radius, a glass border (1px window at 18%) and a soft outer glow in
// window at 8%. The 16:10 box is reserved before anything loads, so nothing shifts. The caption
// sits below it. The frame carries `glass`, so the night scene's interactions (interact.ts) leave
// presses on it alone.
//
// How it behaves (src/scripts/loop-video.ts):
//   - muted, playsinline, loop, no autoplay attribute. The files are in data attributes, not
//     <source> elements: once the video is within one viewport of the screen, the script picks the
//     1280px or the 720px encode by layout (V4.md 8.7), adds its sources and lets it load. The
//     poster waits in data-poster until then too (a poster attribute is fetched at once, which
//     put all three in a phone's first load); without JavaScript a <noscript> image stands in.
//   - Plays while at least half of it is visible, pauses otherwise. While another video plays, a
//     paused one on screen shows its frame as a still image (.vf__still), so two videos are never
//     video layers on screen at once.
//   - On touch screens the glass has no blur (V4.md 8.6), a flat fill and its border instead.
//   - A visible Pause / Play button, labelled with the project's name, at the right end of the
//     caption row under the frame, so it covers nothing in the recording: a 32px disc with a 44px
//     hit area. A pause the visitor makes sticks until they press Play.
//   - Reduced motion: the poster and a Play button; it plays only if asked.
//   - Snapshot mode: the poster only, no button.
//   - If the browser refuses to play (Low Power Mode, data saver) the poster stays and the button
//     says Play. Without JavaScript: the poster only.
import { ui } from '../../data/site';
import type { Clip } from './previews';

interface Props {
  // Used in the button's label: "Pause OurCityHealth preview".
  name: string;
  caption: string;
  src?: Clip;
  class?: string;
}

const { name, caption, src, class: className } = Astro.props;
const label = ui.previewOf(name);
const width = src?.width ?? 1280;
const height = src?.height ?? 800;
---

<figure class:list={['vf', className]} data-vf={src ? '' : undefined} data-state="paused">
  <div class="vf__frame glass">
    <div class="vf__media">
      {
        src ? (
          <>
            <video
              class="vf__video"
              muted
              playsinline
              loop
              preload="none"
              data-poster={src.poster}
              width={width}
              height={height}
              aria-label={label}
              disablepictureinpicture
              disableRemotePlayback
              data-webm={src.webm}
              data-mp4={src.mp4}
              data-small-webm={src.small?.webm}
              data-small-mp4={src.small?.mp4}
            />
            <noscript>
              <img class="vf__poster" src={src.poster} alt="" width={width} height={height} />
            </noscript>
          </>
        ) : (
          <p class="vf__empty">{ui.previewPending}</p>
        )
      }
    </div>
  </div>
  {
    src && (
      <button
        type="button"
        class="vf__btn"
        data-vf-btn
        data-needs-js
        data-snapshot-hide
        data-label={label}
        aria-label={`${ui.play} ${label}`}
      >
        <svg class="vf__icon vf__icon--play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M4.5 2.75v10.5l8.5-5.25z" fill="currentColor" />
        </svg>
        <svg class="vf__icon vf__icon--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M4 2.75h2.75v10.5H4zM9.25 2.75H12v10.5H9.25z" fill="currentColor" />
        </svg>
      </button>
    )
  }
  <figcaption class="vf__cap">{caption}</figcaption>
</figure>

<script>
  import '../../scripts/loop-video';
</script>

<style>
  @import '../../styles/media.css';

  .vf {
    position: relative;
    z-index: 1; /* above neighbouring text scrims */
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  /* A 7px glass mat plus its 1px border: 8px from the frame's edge to the picture. */
  .vf__frame {
    padding: 7px;
    border-radius: var(--radius-frame);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--glow-soft);
  }
  /* Touch screens: no blur over the live canvas (a phone would redo it every frame), a flat fill
     instead; the border and the glow stay. */
  @media (--touch) {
    .vf__frame {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--glass-flat);
    }
  }

  .vf__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-frame) - 8px);
    background: var(--night);
  }
  .vf__video,
  .vf__poster,
  .vf__media :global(.vf__still) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The paused frame, drawn by loop-video.ts over the video it stands in for. */
  .vf__media :global(.vf__still[hidden]) {
    display: none;
  }

  /* The button: in the caption row, at the frame's right edge, off the picture. A 44px hit area
     around a 32px disc. */
  .vf__btn {
    position: absolute;
    right: -6px;
    bottom: calc((var(--tap) - 1.5 * var(--fs-small)) / -2);
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--text);
    transition: color var(--dur-quick) var(--ease-out);
  }
  .vf__btn::before {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: rgb(var(--night-rgb) / 0.72);
    box-shadow: 0 0 0 1px rgb(var(--text-rgb) / 0.22);
    transition: background var(--dur-quick) var(--ease-out);
  }
  /* Hover is only a mouse's: on touch it would stick after a tap. */
  @media (--mouse) {
    .vf__btn:hover {
      color: var(--window);
    }
    .vf__btn:hover::before {
      background: rgb(var(--night-rgb) / 0.9);
    }
  }
  .vf__btn :global(svg) {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .vf__btn:focus-visible {
    border-radius: 50%;
  }
  .vf[data-state='playing'] .vf__icon--play,
  .vf:not([data-state='playing']) .vf__icon--pause {
    display: none;
  }

  .vf__empty {
    position: absolute;
    inset: var(--space-3);
    display: grid;
    place-items: center;
    border: 1px dashed var(--glass-border);
    border-radius: 6px;
    color: var(--dim);
    font-size: var(--fs-small);
    text-align: center;
  }

  /* Text color, not dim, on a compact scrim of its own plus the tight halo: the caption sits at
     the height of the skyline and its reflections. The caption shrinks to its words and the scrim
     hugs them (16px above and below, 24px plus 12% of the caption's width to each side), so it
     can't reach the text column beside the video. */
  .vf__cap {
    position: relative;
    justify-self: start;
    margin-right: calc(var(--tap) + var(--space-2));
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text);
    text-shadow: var(--halo-strong);
  }
  .vf__cap::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-3) * -1) calc(-12% - var(--space-4));
    z-index: -1;
    background: var(--scrim-hug);
    pointer-events: none;
  }
</style>
