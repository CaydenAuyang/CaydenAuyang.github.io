---
// TrackedQuestion.astro: the May question, edited in place into the October question.
//
// It takes the May text, the October text and an ordered list of edits (see `Edit` in
// content.ts):
//   del      strikes words in the May text,
//   ins      inserts new words after an anchor in the May text,
//   replace  strikes words and inserts new ones in their place.
// Struck words are a real <del>, new words a real <ins>, each with a hidden "deleted:" or
// "inserted:" so screen readers say what changed. After each noted edit sits a small numbered
// link to its note in the list below (no hover needed, so it works on phones). The link is
// described by the note's text, so a screen reader reads the note when the link is focused.
//
// A three-way switch (May / Marked / October) shows the clean May text, the marked-up version
// or the clean October text. It is a real radio group, and it works with CSS alone (:has), so
// it needs no JavaScript. Browsers without :has hide the switch and show the marked version,
// which is also the default.
//
// At build time it checks that the edits really turn the May text into the October text, and
// stops the build if they don't, so the two can never drift apart.
import type { Edit, Line, Note } from '../../data/content';
import { ui } from '../../data/site';

interface Props {
  mayLabel: string;
  may: Line;
  octoberLabel: string;
  october: Line;
  edits: Edit[];
  notes: Note[];
}

const { mayLabel, may, octoberLabel, october, edits, notes } = Astro.props;

type Segment =
  | { kind: 'keep'; text: string }
  | { kind: 'del' | 'ins'; text: string; noteId?: string; ref: boolean };

const fail = (message: string): never => {
  throw new Error(`TrackedQuestion: ${message}`);
};

// Turn the May text plus the edits into a row of kept, struck and inserted pieces.
function trackChanges(text: string, list: Edit[]): Segment[] {
  const out: Segment[] = [];
  let cursor = 0;
  const find = (needle: string) => {
    const at = text.indexOf(needle, cursor);
    if (at === -1) fail(`"${needle}" is not in the May text after position ${cursor}.`);
    return at;
  };
  for (const edit of list) {
    if (edit.noteId && !notes.some((n) => n.id === edit.noteId)) {
      fail(`an edit points at note "${edit.noteId}", which is not in question.notes.`);
    }
    if (edit.type === 'del' || edit.type === 'replace') {
      const at = find(edit.text);
      if (at > cursor) out.push({ kind: 'keep', text: text.slice(cursor, at) });
      out.push({ kind: 'del', text: edit.text, noteId: edit.noteId, ref: edit.type === 'del' && !!edit.noteId });
      cursor = at + edit.text.length;
      if (edit.type === 'replace') {
        if (!edit.insertText) fail(`the replace edit for "${edit.text}" has no insertText.`);
        out.push({ kind: 'ins', text: edit.insertText!, noteId: edit.noteId, ref: !!edit.noteId });
      }
    } else {
      const end = edit.after !== undefined ? find(edit.after) + edit.after.length : text.length;
      if (end > cursor) out.push({ kind: 'keep', text: text.slice(cursor, end) });
      cursor = end;
      out.push({ kind: 'ins', text: edit.text, noteId: edit.noteId, ref: !!edit.noteId });
    }
  }
  if (cursor < text.length) out.push({ kind: 'keep', text: text.slice(cursor) });
  return out;
}

const segments = trackChanges(may.text, edits);

// The edits must produce the October text exactly (spaces aside).
const squash = (t: string) => t.replace(/\s+/g, ' ').trim();
const produced = segments.filter((s) => s.kind !== 'del').map((s) => s.text).join('');
if (squash(produced) !== squash(october.text)) {
  fail(`the edits produce "${squash(produced)}", which is not the October text "${squash(october.text)}".`);
}

// Notes are numbered in the order their edits appear.
const noteIds = [...new Set(edits.map((e) => e.noteId).filter((id): id is string => !!id))];
const shownNotes = noteIds.map((id) => notes.find((n) => n.id === id)!);
const number = (id: string) => noteIds.indexOf(id) + 1;

const views = [
  { id: 'may', label: ui.viewMay },
  { id: 'marked', label: ui.viewMarked },
  { id: 'october', label: ui.viewOctober },
];
---

<div class="tq">
  <fieldset class="tq__switch">
    <legend class="sr-only">{ui.viewLegend}</legend>
    {
      views.map((view) => (
        <>
          <input
            class="tq__radio"
            type="radio"
            name="tq-view"
            id={`tq-view-${view.id}`}
            value={view.id}
            checked={view.id === 'marked'}
          />
          <label class="tq__option t-label" for={`tq-view-${view.id}`}>
            {view.label}
          </label>
        </>
      ))
    }
  </fieldset>

  <div class="tq__view tq__view--may">
    <p class="tq__label t-label">{mayLabel}</p>
    <blockquote class="tq__text t-lead">
      <p>{may.text}</p>
    </blockquote>
  </div>

  <div class="tq__view tq__view--marked">
    {/* Written on one line on purpose: line breaks here would put stray spaces around words. */}
    <p class="tq__text t-lead">{segments.map((s) => s.kind === 'keep' ? s.text : <>{s.kind === 'del' ? <del class="tq__del"><span class="sr-only">{`${ui.deleted} `}</span>{s.text}</del> : <ins class="tq__ins"><span class="sr-only">{`${ui.inserted} `}</span>{s.text}</ins>}{s.ref && s.noteId && <sup class="tq__ref"><a href={`#note-${s.noteId}`} id={`edit-${s.noteId}`} aria-label={ui.noteRef(number(s.noteId))} aria-describedby={`note-${s.noteId}-text`}>{number(s.noteId)}</a></sup>}</>)}</p>
  </div>

  <div class="tq__view tq__view--october">
    <p class="tq__label t-label">{octoberLabel}</p>
    <blockquote class="tq__text t-lead">
      <p>{october.text}</p>
    </blockquote>
  </div>

  <ol class="tq__notes">
    {
      shownNotes.map((note) => (
        <li class="tq__note" id={`note-${note.id}`}>
          <span class="tq__note-num t-label">{number(note.id)}.</span>
          <p class="tq__note-text" id={`note-${note.id}-text`}>
            {note.text}
          </p>
          <a class="tq__back t-label" href={`#edit-${note.id}`}>
            {ui.backToEdit}
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .tq {
    display: grid;
    gap: var(--space-6);
    max-width: var(--max-text);
  }

  /* The switch: three radios styled as one segmented control. The real inputs stay in the page
     (keyboard and screen readers use them) but are drawn as their labels. */
  .tq__switch {
    display: none;
    justify-self: start;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--text-2);
    border-radius: var(--radius);
    min-inline-size: 0;
  }
  @supports selector(:has(*)) {
    .tq__switch {
      display: inline-flex;
    }
  }
  .tq__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  .tq__option {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border-radius: 2px;
    cursor: pointer;
    color: var(--text);
  }
  .tq__radio:checked + .tq__option {
    background: var(--text);
    color: var(--bg);
  }
  .tq__radio:focus-visible + .tq__option {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Views: Marked shows by default; the switch swaps in May or October. */
  .tq__view {
    display: grid;
    gap: var(--space-2);
  }
  .tq__view--may,
  .tq__view--october {
    display: none;
  }
  .tq:has(#tq-view-may:checked) .tq__view--may,
  .tq:has(#tq-view-october:checked) .tq__view--october {
    display: grid;
  }
  .tq:has(#tq-view-may:checked) .tq__view--marked,
  .tq:has(#tq-view-october:checked) .tq__view--marked {
    display: none;
  }

  .tq__label {
    color: var(--text-2);
  }
  .tq__text {
    margin: 0;
  }
  .tq__del {
    color: var(--del);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
  /* A replacement sits right after the words it replaces; a small gap keeps them apart. */
  .tq__del + .tq__ins {
    margin-left: 0.2em;
  }
  .tq__ins {
    color: var(--ins);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }
  .tq__ref {
    font-size: 0.65em;
    line-height: 0;
  }
  .tq__ref a {
    display: inline-block;
    min-width: 24px;
    min-height: 24px;
    line-height: 24px;
    padding-inline: 2px;
    text-align: center;
  }

  .tq__notes {
    display: grid;
    gap: var(--space-4);
  }
  .tq__note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4);
    background: var(--bg-2);
    border-radius: var(--radius);
    scroll-margin-top: var(--space-6);
  }
  .tq__note-num {
    color: var(--text-2);
    padding-top: 0.15em;
  }
  .tq__note-text {
    font-size: var(--fs-small);
  }
  .tq__back {
    grid-column: 2;
    justify-self: start;
  }
</style>
