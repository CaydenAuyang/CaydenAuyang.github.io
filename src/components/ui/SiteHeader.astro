---
// SiteHeader.astro: the sticky bar at the top (sticky inside the Google Sites frame's own scroll).
//
// Laptop: the name, the six section links, then the two clocks.
// Phone: the name and an "Index" button that slides the section links down as a sheet (focus
// moves into it and back to the button; Esc, a link or the button closes it), with the clocks
// on a small second line.
// Without JavaScript: no button; the links show as a wrapped row, and the clocks show the place
// names only (the time difference changes with daylight saving, so it is never written down).
// When the page is shown inside another page (the program's Google Site), an "Open the full
// site" link appears, opening this site in a new tab.
// Snapshot mode hides the clocks, the Index button and "Open the full site".
import { hero, nav as links } from '../../data/content';
import { site, ui } from '../../data/site';

interface Props {
  nav?: boolean;
}
const { nav = false } = Astro.props;
---

<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <a class="hdr__name" href={nav ? '#top' : '/'}>{hero.name}</a>
    {
      nav && (
        <div class="hdr__sheet">
          <nav class="hdr__nav" id="site-index" aria-label={ui.navLabel}>
            <ul class="hdr__links">
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )
    }
    <p class="hdr__clocks t-label tnum" data-clocks data-snapshot-hide>
      <span>{ui.clockPomfret} <span data-tz="America/New_York"></span></span>
      <span aria-hidden="true">·</span>
      <span>{ui.clockHongKong} <span data-tz="Asia/Hong_Kong"></span></span>
    </p>
    <a class="hdr__full t-label" href={`${site.url}/`} target="_blank" rel="noopener" data-full-site data-snapshot-hide hidden
      >{ui.openFullSite}<span class="sr-only"> {ui.newTab}</span></a
    >
    {
      nav && (
        <button
          type="button"
          class="hdr__index"
          aria-expanded="false"
          aria-controls="site-index"
          data-index-button
          data-snapshot-hide
          hidden
        >
          {ui.index}
        </button>
      )
    }
  </div>
</header>

<script>
  // Clocks: the time now in Pomfret and Hong Kong, updated once a minute.
  const clocks = document.querySelectorAll<HTMLElement>('[data-tz]');
  function tick() {
    const now = new Date();
    clocks.forEach((el) => {
      el.textContent = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
        timeZone: el.dataset.tz,
      }).format(now);
    });
  }
  if (clocks.length) {
    tick();
    // Line up with the start of the next minute, then every 60 seconds.
    setTimeout(
      () => {
        tick();
        setInterval(tick, 60_000);
      },
      60_000 - (Date.now() % 60_000),
    );
  }

  // "Open the full site" only when this page is shown inside another page.
  let framed = false;
  try {
    framed = window.self !== window.top;
  } catch {
    framed = true;
  }
  if (framed) document.querySelectorAll<HTMLElement>('[data-full-site]').forEach((el) => (el.hidden = false));

  // The phone Index sheet.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-index-button]');
  const sheetNav = document.getElementById('site-index');
  if (header && button && sheetNav) {
    button.hidden = false;
    const links = Array.from(sheetNav.querySelectorAll<HTMLAnchorElement>('a'));
    const isOpen = () => header.hasAttribute('data-open');
    const open = () => {
      header.setAttribute('data-open', '');
      button.setAttribute('aria-expanded', 'true');
      links[0]?.focus();
    };
    const close = (returnFocus: boolean) => {
      header.removeAttribute('data-open');
      button.setAttribute('aria-expanded', 'false');
      if (returnFocus) button.focus();
    };
    button.addEventListener('click', () => (isOpen() ? close(false) : open()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });
    links.forEach((link) => link.addEventListener('click', () => close(false)));
    // Focus leaving the header (Tab past the last link) closes the sheet.
    header.addEventListener('focusout', (event) => {
      if (isOpen() && !header.contains(event.relatedTarget as Node | null)) close(false);
    });
    // Growing to laptop width: the links sit in the bar again, so drop the open state.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => close(false));
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .hdr__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-4);
    min-height: var(--header-h);
    padding-block: var(--space-1);
  }
  .hdr__name {
    margin-right: auto;
    padding-block: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: 1.125rem;
    text-decoration: none;
  }
  .hdr__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  .hdr__links a {
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--fs-small);
  }
  .hdr__clocks {
    margin: 0;
    white-space: nowrap;
  }
  .hdr__clocks > span + span {
    margin-left: var(--space-1);
  }
  .hdr__full {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
  }
  .hdr__index {
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--neatline);
    font-size: var(--fs-small);
  }

  /* ---- Phones and tablets ---- */
  @media (max-width: 1023px) {
    .hdr__sheet {
      order: 5;
      flex-basis: 100%;
    }
    .hdr__clocks {
      order: 4;
      flex-basis: 100%;
      padding-bottom: var(--space-2);
    }
    /* With JavaScript the links become a sheet that slides down from under the bar (M11). The
       clip box hangs below the bar and hides the sheet while it waits above, out of view. */
    :global(html.js) .hdr__sheet {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      overflow: hidden;
      pointer-events: none;
    }
    :global(html.js) .hdr__nav {
      padding: var(--space-2) var(--margin) var(--space-5);
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      transform: translateY(-100%);
      visibility: hidden;
      transition:
        transform var(--dur-quick) var(--ease-quick),
        visibility 0s linear var(--dur-quick);
    }
    :global(html.js) .hdr[data-open] .hdr__nav {
      transform: none;
      visibility: visible;
      pointer-events: auto;
      transition:
        transform var(--dur-sheet) var(--ease-settle),
        visibility 0s;
    }
    :global(html.js) .hdr__links {
      display: grid;
      gap: 0;
    }
    :global(html.js) .hdr__links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: var(--fs-lead);
    }
  }

  /* ---- Laptops: one row, links then clocks ---- */
  @media (min-width: 1024px) {
    .hdr__bar {
      flex-wrap: nowrap;
      column-gap: var(--space-6);
    }
    .hdr__name {
      margin-right: var(--space-4);
    }
    .hdr__sheet {
      margin-right: auto;
    }
    .hdr__index {
      display: none;
    }
  }
</style>
