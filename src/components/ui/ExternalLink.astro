---
// ExternalLink.astro: a link to another site. It always opens in a new tab, because this site is
// shown inside the certificate program's Google Site, in a frame that can't navigate away.
// rel="noopener" keeps the new tab from reaching back into this page. Screen readers hear
// "(opens in a new tab)"; `hint` adds context after the visible words (for link text such as
// "GitHub" that repeats on the page). Both go in an aria-label that starts with the visible
// words, so the name is exact ("GitHub, Inferno Acoustic Map (opens in a new tab)"): hidden
// spans taken out of the flow would put a stray space before the comma.
import { ui } from '../../data/site';

interface Props {
  href: string;
  class?: string;
  hint?: string;
  arrow?: boolean;
}
const { href, class: className, hint, arrow = false } = Astro.props;
// The visible words, as plain text.
const words = (await Astro.slots.render('default'))
  .replace(/<[^>]*>/g, '')
  .replace(/&amp;/g, '&')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .replace(/\s+/g, ' ')
  .trim();
if (!words) throw new Error(`ExternalLink: the link to ${href} has no visible words.`);
const label = `${words}${hint ? `, ${hint}` : ''} ${ui.newTab}`;
---

<a href={href} class={className} target="_blank" rel="noopener" aria-label={label}
  ><slot />{
    arrow && (
      <svg class="arrow" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <path d="M3.5 10.5 10.5 3.5M5 3.5h5.5V9" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    )
  }</a
>
