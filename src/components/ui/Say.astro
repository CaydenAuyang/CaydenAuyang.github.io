---
// Say.astro: shows one Line from content.ts.
// A pending line (only Cayden can supply it) shows as a dashed "To come" chip. Its source and
// any confirm note stay in the data and are never rendered.
import type { Line } from '../../data/content';

interface Props {
  line: Line;
}
const { line } = Astro.props;
---

{line.pending ? <span class="pending" data-pending>{line.text}</span> : line.text}
