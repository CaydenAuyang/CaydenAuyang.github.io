---
// MissionPanel.astro: the mission's question as it was (Previously), edited in place into what it
// is now (Now), on a glass panel sized to its text (V4 section 5). It has no title of its own: the
// Previously / Edits / Now switch is its only label.
//
// A Previously / Edits / Now switch shows the clean Previously text, the marked version, or the
// clean Now text. Default: Now. It is a real radio group that works with CSS alone (:has), so it
// needs no JavaScript; browsers without :has hide the switch and show Now.
//
// The marked version (phrase level): each old phrase is a real <del>, dimmed with a thin line
// through, plus a hidden "deleted"; its new phrase follows as a real <ins> in window, plus a hidden
// "inserted".
// The panel carries `glass`, so the night scene's interactions (interact.ts) leave presses on it
// alone. It is #mission-panel: the timeline clears the figure as it rises (timeline.ts).
//
// Height: every view sits in one grid cell, as tall as the marked version (the tallest), so the
// text area keeps one height at every stop and the slider and the switch never move, whether the
// view changes by a drag (mouse, pen or touch), a preset or a key. Nothing around the panel moves
// either (no layout shift, no timeline rebuild).
//
// The scrubber (NIGHT-SIGNAL.md 11b.5, src/scripts/mission.ts): under the text, a native range
// input from Previously to Now, one stop per edit: 0 is Previously (clean), 1 to 3 apply the edits
// one by one in reading order (marked as in the Edits view), 4 is Now (clean). The switch becomes
// three presets that move it: Previously 0, Edits 3, Now 4 (the default). Each strike draws and
// each insertion lights as the handle passes it. Arrow keys move one edit at a time;
// aria-valuetext says what each stop shows. With JavaScript the one marked paragraph shows every
// stop (each edit is a span the script turns on and off), and an invisible copy with every edit
// marked holds the cell at the tallest stop's height; without it, the switch shows the three fixed
// views, hidden rather than removed, so the marked one holds the height.
// Snapshot: the marked version, no scrubber, and the switch on Edits as its key (inert).
//
// At build time it checks that the edits turn the Previously text into the Now text exactly; if
// not, the build stops with an error, so a typo can't ship.
import type { Edit, Line } from '../../data/content';
import { ui } from '../../data/site';

interface Props {
  views: { from: string; edits: string; to: string };
  from: Line;
  to: Line;
  edits: Edit[];
}

const { views, from, to, edits } = Astro.props;

const fail = (message: string): never => {
  throw new Error(`MissionPanel: ${message}`);
};

type Piece = { kind: 'keep'; text: string } | { kind: 'edit'; del?: string; ins?: string };

// Turn the Previously text plus the edits into kept text and edits.
const pieces: Piece[] = [];
let cursor = 0;
const find = (needle: string) => {
  const at = from.text.indexOf(needle, cursor);
  if (at === -1) fail(`"${needle}" is not in the Previously text after position ${cursor}.`);
  return at;
};
for (const edit of edits) {
  if (edit.type === 'del' || edit.type === 'replace') {
    if (edit.type === 'replace' && !edit.insertText) fail(`the replace edit for "${edit.text}" has no insertText.`);
    const at = find(edit.text);
    if (at > cursor) pieces.push({ kind: 'keep', text: from.text.slice(cursor, at) });
    cursor = at + edit.text.length;
    pieces.push({ kind: 'edit', del: edit.text, ins: edit.insertText });
  } else {
    const end = edit.after ? find(edit.after) + edit.after.length : cursor;
    if (edit.after === undefined) fail(`the insert "${edit.text}" needs an "after" ('' for right after the last edit).`);
    if (end > cursor) pieces.push({ kind: 'keep', text: from.text.slice(cursor, end) });
    cursor = end;
    pieces.push({ kind: 'edit', ins: edit.text });
  }
}
if (cursor < from.text.length) pieces.push({ kind: 'keep', text: from.text.slice(cursor) });

// The edits must produce the Now text exactly. A struck word leaves a double space behind it
// ("to  hear"); that collapses, and nothing else is forgiven.
const produced = pieces
  .map((p) => (p.kind === 'keep' ? p.text : (p.ins ?? '')))
  .join('')
  .replace(/ {2,}/g, ' ');
if (produced !== to.text) fail(`the edits produce\n  "${produced}"\nwhich is not the Now text\n  "${to.text}".`);

// The marked sentence is one HTML string: line breaks between tags would put stray spaces
// around words. Every piece of text is escaped.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Each edit is a span the scrubber turns on (applied) and off (the Previously words); on, with the
// paragraph's .is-clean, is the default Now view; on without it is the Edits view. A replacement's
// space sits inside its insertion, so it goes with it.
let step = 0;
const marked = pieces
  .map((p) => {
    if (p.kind === 'keep') return esc(p.text);
    step += 1;
    let out = `<span class="qp__edit is-on" data-step="${step}">`;
    if (p.del) out += `<del class="qp__del"><span class="sr-only">${ui.deleted}: </span>${esc(p.del)}</del>`;
    const space = p.del && p.ins && !p.ins.startsWith(',') ? ' ' : '';
    if (p.ins) out += `<ins class="qp__ins">${space}<span class="sr-only">${ui.inserted}: </span>${esc(p.ins)}</ins>`;
    return `${out}</span>`;
  })
  .join('');

// What each stop of the scrubber shows, for screen readers (aria-valuetext).
const editPieces = pieces.filter((p): p is Extract<Piece, { kind: 'edit' }> => p.kind === 'edit');
const trimWords = (t: string) => t.replace(/^[,\s]+/, '');
const stopTexts = [
  views.from,
  ...editPieces.map((p, i) => {
    const what = p.del && p.ins ? ui.scrubReplaced(p.del, trimWords(p.ins)) : p.del ? ui.scrubStruck(p.del) : ui.scrubInserted(trimWords(p.ins ?? ''));
    const text = ui.scrubStep(i + 1, editPieces.length, what);
    return i === editPieces.length - 1 ? `${views.edits}. ${text}` : text;
  }),
  views.to,
];
const EDITS_STOP = editPieces.length;
const LAST_STOP = editPieces.length + 1;
// The default view is Now: the last stop.
const START_STOP = LAST_STOP;
---

<div class="qp glass" id="mission-panel">
  <fieldset class="qp__switch" data-qp-switch>
    <legend class="sr-only">{ui.viewLegend}</legend>
    <input class="sr-only" type="radio" name="qp-view" id="qp-from" value="from" />
    <label class="qp__opt" for="qp-from">{views.from}</label>
    <input class="sr-only" type="radio" name="qp-view" id="qp-edits" value="edits" />
    <label class="qp__opt" for="qp-edits">{views.edits}</label>
    <input class="sr-only" type="radio" name="qp-view" id="qp-to" value="to" checked />
    <label class="qp__opt" for="qp-to">{views.to}</label>
  </fieldset>

  <div class="qp__views" aria-live="polite" data-qp-views>
    <p class="qp__text qp__view qp__view--from">{from.text}</p>
    <p class="qp__text qp__view qp__view--edits" data-qp-marked set:html={marked} />
    <p class="qp__text qp__view qp__view--to">{to.text}</p>
    <!-- The scrubber's tallest stop (every edit marked), invisible: it holds the cell at that
         height, so the slider and the switch never move as the handle goes. -->
    <p class="qp__text qp__view qp__ghost" aria-hidden="true" set:html={marked} />
  </div>

  <div class="qp__scrub" data-qp-scrub data-needs-js data-snapshot-hide>
    <label class="qp__scrub-label" for="qp-scrub">{ui.scrubLabel}</label>
    <div class="qp__track" style={`--stops: ${LAST_STOP}`}>
      <input
        id="qp-scrub"
        class="qp__range"
        type="range"
        min="0"
        max={LAST_STOP}
        step="1"
        value={START_STOP}
        aria-valuetext={stopTexts[START_STOP]}
        data-texts={JSON.stringify(stopTexts)}
        data-edits-stop={EDITS_STOP}
      />
      <span class="qp__ticks" aria-hidden="true">
        {stopTexts.map((_, i) => <span class="qp__tick" style={`--t: ${i}`} />)}
      </span>
    </div>
  </div>
</div>

<script>
  import '../../scripts/mission';
</script>

<style>
  /* Glass: one of only two places it appears (the other is the video frames). Sized to its text:
     at most 34rem wide on desktop, the full width inside the gutters on phones, 24px of padding. */
  .qp {
    max-width: 34rem;
    padding: var(--space-4);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-frame);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--glow-soft);
  }

  /* The switch: three segments, each a 44px target. */
  .qp__switch {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    margin-bottom: var(--space-4);
    border-radius: var(--radius-control);
    border: 1px solid var(--rule);
    background: rgb(var(--night-rgb) / 0.5);
  }
  .qp__opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--dim);
    cursor: pointer;
    transition:
      color var(--dur-quick) var(--ease-out),
      background var(--dur-quick) var(--ease-out);
  }
  @media (min-width: 768px) {
    .qp__opt {
      padding: 0 var(--space-4);
    }
  }
  /* The narrowest phones: "Previously" needs the room. */
  @media (max-width: 359px) {
    .qp__opt {
      padding: 0 var(--space-2);
    }
  }
  .qp__opt:hover {
    color: var(--text);
  }
  .qp__switch input:checked + .qp__opt {
    background: var(--text);
    color: var(--night);
  }
  .qp__switch input:focus-visible + .qp__opt {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--focus-halo);
  }

  /* Inside the glass, a soft night ellipse under the text (the glass alone is night at 45%): the dim
     struck words are small text now and need 4.5:1 where the panel sits over the lit city. */
  .qp__views {
    position: relative;
    display: grid;
  }
  .qp__views::before {
    content: '';
    position: absolute;
    inset: calc(var(--space-3) * -1) calc(var(--space-4) * -1);
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgb(var(--night-rgb) / 0.5) 0%,
      rgb(var(--night-rgb) / 0.5) 78%,
      rgb(var(--night-rgb) / 0) 100%
    );
    pointer-events: none;
  }
  /* The panel's width is the measure: 34rem less its padding holds 41 characters at 20px and 48
     at 17px, under the 60 the spec allows. */
  .qp__text {
    font-size: var(--fs-mission);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* Every view in one cell, so the text area is always the tallest view's height. Now is the
     default and the only view without :has. The others are hidden, not removed, so they keep the
     height. */
  .qp__view {
    grid-area: 1 / 1;
  }
  .qp__view--from,
  .qp__view--edits,
  .qp__ghost {
    visibility: hidden;
  }
  .qp:has(#qp-from:checked) .qp__view--from,
  .qp:has(#qp-edits:checked) .qp__view--edits {
    visibility: visible;
  }
  .qp:has(#qp-from:checked) .qp__view--to,
  .qp:has(#qp-edits:checked) .qp__view--to {
    visibility: hidden;
  }
  .qp__ghost {
    display: none;
  }
  @supports not selector(:has(*)) {
    .qp__switch {
      display: none;
    }
  }
  /* Snapshot: the switch reads Edits from the first paint (mission.ts then checks it and makes the
     switch inert), and the marked version only. */
  :global(html[data-snapshot]) .qp__switch input:checked:not(#qp-edits) + .qp__opt {
    background: none;
    color: var(--dim);
  }
  :global(html[data-snapshot]) .qp__switch #qp-edits + .qp__opt {
    background: var(--text);
    color: var(--night);
  }
  :global(html[data-snapshot]) .qp__view--edits {
    display: block !important;
    visibility: visible !important;
  }
  :global(html[data-snapshot]) .qp__view--from,
  :global(html[data-snapshot]) .qp__view--to {
    display: none !important;
  }

  /*
    The marked paragraph. Each edit is on (applied: struck words dim with a line through,
    insertions in window) or off (the Previously words, plain; insertions gone). .is-clean is Now:
    struck words gone, insertions plain. The line through is a 1px background, so it can draw left
    to right as the scrubber passes; forced colors get a real line-through.
  */
  /* Struck words are dim at lead size (small text, 4.5:1): the strong halo keeps them clear where
     the glass sits over the lit city. */
  .qp__text :global(.qp__del) {
    color: var(--dim);
    text-shadow: var(--halo-strong);
    text-decoration: none;
    background: linear-gradient(var(--strike), var(--strike)) no-repeat 0 58% / 100% 1px;
    transition:
      background-size 320ms var(--ease-out),
      color 320ms var(--ease-out);
  }
  .qp__text :global(.qp__ins) {
    color: var(--window);
    text-decoration: none;
  }
  .qp__text :global(.qp__edit:not(.is-on) .qp__del) {
    color: inherit;
    background-size: 0% 1px;
  }
  .qp__text :global(.qp__edit:not(.is-on) .qp__ins),
  .qp__text:global(.is-clean) :global(.qp__del),
  .qp__text :global(.qp__edit:not(.is-on) .qp__del .sr-only),
  .qp__text:global(.is-clean) :global(.qp__ins .sr-only) {
    display: none;
  }
  .qp__text:global(.is-clean) :global(.qp__ins) {
    color: inherit;
  }
  /* Just applied: the insertion lights up like the windows. */
  .qp__text :global(.qp__edit.is-new .qp__ins) {
    animation: qp-ins 520ms var(--ease-out);
  }
  @keyframes qp-ins {
    from {
      opacity: 0;
      color: var(--ign-hot);
      text-shadow: 0 0 14px rgb(var(--window-rgb) / 0.8);
    }
  }
  @media (forced-colors: active) {
    .qp__text :global(.qp__edit.is-on .qp__del) {
      text-decoration: line-through;
    }
  }

  /* With the scrubber, the one marked paragraph shows every stop, and the ghost (every edit
     marked) holds the cell at the tallest stop's height. */
  .qp:global(.is-scrub) .qp__view--from,
  .qp:global(.is-scrub) .qp__view--to {
    display: none !important;
  }
  .qp:global(.is-scrub) .qp__view--edits {
    display: block !important;
    visibility: visible !important;
  }
  .qp:global(.is-scrub) .qp__ghost {
    display: block;
  }

  /* The scrubber: a native range input, 44px tall, a thin track that fills in window up to the
     handle, and one small tick per stop that lights once the handle has reached it. */
  .qp__scrub {
    margin-top: var(--space-4);
  }
  /* Text color, not dim: the glass can sit over the lit skyline, and this is a control's label. */
  .qp__scrub-label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text);
  }
  .qp__track {
    --thumb: 22px;
    --p: 0;
    position: relative;
  }
  /* On touch, a sideways drag moves the handle and an up or down swipe still scrolls the page
     (V4 section 8.4). Without pan-y the browser claimed the drag as a pan (pointercancel) while the
     handle went on moving, so the text's reflow counted as a layout shift. */
  .qp__range {
    display: block;
    width: 100%;
    height: var(--tap);
    margin: 0;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    touch-action: pan-y;
  }
  .qp__range::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(to right, var(--window) calc(var(--p) * 100%), var(--rule) calc(var(--p) * 100%));
  }
  .qp__range::-moz-range-track {
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(to right, var(--window) calc(var(--p) * 100%), var(--rule) calc(var(--p) * 100%));
  }
  .qp__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: var(--thumb);
    height: var(--thumb);
    margin-top: calc((2px - var(--thumb)) / 2);
    border-radius: 50%;
    border: 2px solid var(--night);
    background: var(--window);
    box-shadow:
      0 0 0 1px rgb(var(--window-rgb) / 0.5),
      0 0 14px rgb(var(--window-rgb) / 0.55);
  }
  .qp__range::-moz-range-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border-radius: 50%;
    border: 2px solid var(--night);
    background: var(--window);
    box-shadow:
      0 0 0 1px rgb(var(--window-rgb) / 0.5),
      0 0 14px rgb(var(--window-rgb) / 0.55);
  }
  .qp__range:focus-visible {
    border-radius: var(--radius-control);
  }
  .qp__ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .qp__tick {
    position: absolute;
    top: 50%;
    left: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--t) / var(--stops));
    width: 4px;
    height: 4px;
    margin: 6px 0 0 -2px;
    border-radius: 50%;
    background: var(--rule);
    transition: background var(--dur-quick) var(--ease-out);
  }
  .qp__tick:global(.is-lit) {
    background: var(--window);
  }

  /* On paper the panel shows one view and doesn't change, so it needs no room held for it. */
  @media print {
    .qp__ghost {
      display: none !important;
    }
  }
</style>
