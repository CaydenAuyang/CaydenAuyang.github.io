---
// SnapshotToggle.astro: the "Snapshot view" switch in the footer.
//
// Snapshot view is for poster screenshots: white ground, darker text, no motion, and none of
// the buttons (tokens.css and base.css hold the rules). It is also on whenever the address has
// ?snapshot, and always when printing. The choice is saved in the browser (localStorage, inside
// try/catch because the Google Sites frame can block storage); switching it off clears it.
import { site, ui } from '../../data/site';
---

<button type="button" class="snap-toggle" data-snapshot-toggle aria-pressed="false" data-key={site.snapshotKey}>
  {ui.snapshot}: <span data-snapshot-state>{ui.motionOff}</span>
</button>

<script>
  import { site, ui } from '../../data/site';

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-snapshot-toggle]');

  function render() {
    const on = root.hasAttribute('data-snapshot');
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
      const state = button.querySelector('[data-snapshot-state]');
      if (state) state.textContent = on ? ui.motionOn : ui.motionOff;
    });
  }

  function set(on: boolean) {
    if (on) root.setAttribute('data-snapshot', '');
    else root.removeAttribute('data-snapshot');
    try {
      if (on) localStorage.setItem(site.snapshotKey, 'on');
      else localStorage.removeItem(site.snapshotKey);
    } catch {
      // Storage blocked: the switch still works for this page.
    }
    // Switching off also drops ?snapshot from the address, so a reload stays off.
    if (!on && /[?&]snapshot/.test(location.search)) {
      try {
        const url = new URL(location.href);
        url.searchParams.delete('snapshot');
        history.replaceState(history.state, '', url);
      } catch {
        // Not allowed in this frame: the switch still works for this page.
      }
    }
    render();
    // motion.ts sees data-snapshot change and tells every component (motion counts as off).
  }

  buttons.forEach((button) => button.addEventListener('click', () => set(!root.hasAttribute('data-snapshot'))));
  render();
</script>

<style>
  .snap-toggle {
    justify-self: start;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--neatline);
    font-size: var(--fs-small);
  }
  :global(html:not(.js)) .snap-toggle {
    display: none;
  }
</style>
