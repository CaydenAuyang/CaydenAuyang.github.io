---
// Base.astro: the frame every page is built inside.
//
// It writes the parts visitors don't see directly (title, description, share image, tab icon)
// and the parts every page shares: the skip link, the world's two layers (a still or gradient,
// and the fixed three.js canvas above it), the header, <main id="main"> and the footer slot.
//
// Two scripts run:
//   1. A tiny one at the very top, before anything is drawn, that sets the page's modes on
//      <html> (js, data-motion, data-snapshot, js-intro). Doing it first means nothing flickers.
//   2. After the first paint, the night scene (src/world/main.ts, the lead's), which starts the
//      scroll timeline and then, if WebGL works, the world and the signal.
//
// The site is embedded in the certificate program's Google Site, inside a sandboxed frame.
// Nothing here may stop that: no X-Frame-Options and no frame-ancestors rule, and every link to
// another site opens in a new tab (ExternalLink.astro).
//
// Pages use it like:  <Base>...sections...<Contact slot="footer" /></Base>
import '../styles/tokens.css';
import '../styles/base.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Font } from 'astro:assets';
import { meta } from '../data/content';
import { site, ui } from '../data/site';
import Header from '../components/Header.astro';
import WorldBoot from '../components/WorldBoot.astro';

interface Props {
  // The full page title for the browser tab. Defaults to the site's name.
  title?: string;
  description?: string;
  // Keep this page out of search engines.
  noindex?: boolean;
  // Show the Menu (the home page only).
  menu?: boolean;
  // Start the night scene (the home page only).
  world?: boolean;
}

const { title = meta.title, description = meta.description.text, noindex = false, menu = false, world = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// The "page not found" page shows at whatever wrong address someone typed, so it has no
// permanent address of its own: no canonical link and no og:url.
const isNotFound = /^\/404(\.html|\/)?$/.test(Astro.url.pathname);
const imageUrl = new URL(site.ogImage, Astro.site);

// The lead's still renders of the hero scene, used where WebGL is missing and until the canvas
// is ready. Checked at build time: until a file exists the CSS gradient stands in, and a phone
// still that doesn't exist yet falls back to the desktop one. Not preloaded: with WebGL they are
// rarely needed, so the browser fetches one only when the CSS actually paints it.
const STILL_DESKTOP = '/world/fallback-hero.webp';
const STILL_PHONE = '/world/fallback-hero-phone.webp';
const exists = (path: string) => existsSync(join(process.cwd(), 'public', path));
const stillDesktop = exists(STILL_DESKTOP) ? STILL_DESKTOP : exists(STILL_PHONE) ? STILL_PHONE : null;
const stillPhone = exists(STILL_PHONE) ? STILL_PHONE : stillDesktop;
const stillStyle = stillDesktop ? `--still-desktop: url('${stillDesktop}'); --still-phone: url('${stillPhone}')` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && !isNotFound && <link rel="canonical" href={canonical} />}
    {(noindex || isNotFound) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <!-- What a link preview shows when someone shares this page. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Fonts: the two faces the first screen needs are preloaded. -->
    <Font cssVariable="--font-unbounded" preload={[{ weight: 700, style: 'normal' }]} />
    <Font
      cssVariable="--font-geist"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 500, style: 'normal' },
      ]}
    />

    <!--
      Runs before the page is drawn. Sets on <html>:
        js                  JavaScript works (menus, toggles and video buttons need it).
        data-motion="off"   the device asks for reduced motion.
        data-snapshot       the address has ?snapshot (any value): poster screenshots.
        js-intro            motion on and not snapshot: the hero text starts masked and the
                            timeline wipes it in. A CSS safety net reveals it after 2.5 s anyway.
    -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) html.setAttribute('data-motion', 'off');
        var snap = /[?&]snapshot(=|&|$)/.test(location.search);
        if (snap) html.setAttribute('data-snapshot', '');
        if (!reduce && !snap) html.classList.add('js-intro');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>

    <div
      class="world-fallback"
      data-world-fallback
      data-still={stillDesktop ? '' : undefined}
      style={stillStyle}
      aria-hidden="true"
    >
    </div>
    {world && <canvas class="world-canvas" data-world aria-hidden="true"></canvas>}

    <Header menu={menu} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />

    {world && <WorldBoot />}
  </body>
</html>
